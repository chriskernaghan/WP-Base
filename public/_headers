# _headers — Cloudflare Pages reads this file and applies the rules at the edge.
# Same syntax as _redirects: a path pattern, then indented header lines beneath it.
# Order matters, first match wins, so the specific rules sit above the general ones.

# ===== Prospect and client demos: never index =====
# These pages carry other companies' branding. They are built for sales
# conversations, not for search. X-Robots-Tag is the header equivalent of a
# noindex meta tag and works on any file type, which matters here because
# these are raw HTML dropped into /public rather than Astro pages.

/demos/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Prospect demo sitting in the case-studies path. Not a client.
/case-studies/rafferty-mcgrath.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# ===== Post-payment page: never index =====
# Only ever reached after a Stripe checkout, no value in search results.
/welcome
  X-Robots-Tag: noindex, nofollow

/welcome/*
  X-Robots-Tag: noindex, nofollow

# ===== Cache lifetimes =====
# Everything Astro emits into /_astro/ has a content hash in the filename, so a
# changed file gets a changed URL. That makes it safe to cache for a year and
# tell the browser never to revalidate. This is where repeat visits get quick.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images in /public keep their filenames across deploys, so they cannot be
# marked immutable. A month with stale-while-revalidate means repeat visitors
# render instantly from cache while the browser checks for a newer copy in the
# background. If an image is ever replaced under the same name, rename it or
# expect up to a month of stale copies in the wild.

/blog/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/case-studies/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# ===== Baseline security headers for the whole site =====
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

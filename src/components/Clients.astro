---
// Clients.astro — case study cards. Data here so adding a client is one entry.

const clients = [
  {
    num: '01',
    name: 'Catagen',
    desc: 'Full Squarespace-to-WordPress migration, custom Divi theme, and ongoing care across two domains.',
    statValue: '4 yrs',
    statLabel: '& counting',
    href: '/case-studies/catagen/',
  },
  {
    num: '02',
    name: 'Export Explore',
    desc: 'Custom WordPress build with ongoing maintenance and performance monitoring.',
    statValue: '100%',
    statLabel: 'Uptime',
    href: '/case-studies/exportexplore/',
  },
  {
    num: '03',
    name: 'InclusionIQ',
    desc: 'Full platform migration to WP Engine with bespoke theme and ongoing support.',
    statValue: 'WP Engine',
    statLabel: 'Platform',
    href: '/case-studies/inclusion-iq/',
  },
];
---

<section id="clients" class="clients-section">
  <div class="clients-inner">
    <div class="section-header-split">
      <div class="section-header-left">
        <span class="section-label">Selected Work</span>
        <h2>Long-term partnerships,<br />not one-off projects.</h2>
      </div>
      <div class="section-header-right">
        Every client relationship is built on trust, direct communication, and work that actually gets done.
      </div>
    </div>
    <div class="clients-grid-v2">
      {clients.map((client) => (
        <a href={client.href} class="client-card-v2">
          <div class="client-card-top">
            <span class="client-num">{client.num}</span>
            <span class="client-card-name">{client.name}</span>
            <span class="client-card-desc">{client.desc}</span>
          </div>
          <div class="client-card-bottom">
            <div class="client-stat">
              <span class="client-stat-value">{client.statValue}</span>
              <span class="client-stat-label" set:html={client.statLabel}></span>
            </div>
            <div class="client-card-arrow">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 12L12 4M12 4H5M12 4v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="clients-partner">
      <img
        class="clients-partner-logo"
        src="/partners/wp-engine-logo.webp"
        alt="WP Engine"
        width="240"
        height="47"
        loading="lazy"
        decoding="async"
      />
      <p class="clients-partner-text">
        <strong>Agency Partner</strong>, with client sites running on the platform.
      </p>
      <a class="clients-partner-link" href="/hosting/#recommendation">See how I handle hosting →</a>
    </div>
  </div>
</section>

<style>
  /* WP Engine partner line under the case study cards. Logo is the official
     mark supplied through the Agency Partner Program, used as-is. */
  .clients-partner {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .clients-partner-logo {
    display: block;
    width: 160px;
    height: auto;
    flex-shrink: 0;
  }
  .clients-partner-text {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-dark);
    margin: 0;
  }
  .clients-partner-text strong {
    font-weight: 600;
    color: var(--midnight);
  }
  .clients-partner-link {
    margin-left: auto;
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 1px;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .clients-partner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .clients-partner-link {
      margin-left: 0;
    }
  }
</style>
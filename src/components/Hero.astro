---
// Hero.astro: homepage hero on a single midnight surface.
//
// The old split (dark copy panel, cream card panel) is gone. One background,
// one soft lime glow behind the chat card, and the page gutter taken from the
// same formula the header uses, so the brand sits over the headline and the
// Get in Touch button sits over the card's right edge at every width.
//
// Lime is rationed to three jobs: the closing phrase of the headline (the
// promise), the main button (the action) and Chris's replies in the chat (the
// voice). Everything else is cream on midnight.
//
// Styles are scoped to this component and use their own .hero-calm-* names, so
// HeroLocal.astro (/northern-ireland/) is unaffected. Corner radii come from
// the shared tokens in global.css (--radius-pill, --radius-lg). HeroChat.astro
// is shared with HeroLocal, so the dark-on-dark look is applied from here with
// :global() overrides, while its shape lives in HeroChat itself.
//
// The "hero-split" class is kept on the section as a marker only. Nav.astro
// keys its clear, cream-ink header on body:has(.hero-split), which is what
// stops the header flashing white on first paint. Nothing in global.css
// styles .hero-split on its own, so the class has no side effects here.
import HeroChat from './HeroChat.astro';
---

<section class="hero-calm hero-split" aria-labelledby="hero-heading">
  <div class="hero-calm-glow" aria-hidden="true"></div>

  <div class="hero-calm-inner">
    <div class="hero-calm-copy">
      <a href="https://share.google/HmqVC5OhdKakcRtS4" target="_blank" rel="noopener" class="hero-calm-rating">
        <span class="hero-calm-stars" aria-hidden="true">★★★★★</span>
        <span><strong>5.0</strong> on Google</span>
      </a>

      <h1 class="hero-calm-headline" id="hero-heading">
        A WordPress site you never have <span class="hero-calm-accent">to worry about</span>
      </h1>

      <p class="hero-calm-desc">
        I handle the updates, backups, security and technical SEO for a fixed
        monthly fee, so your site stays fast, safe and easy for Google to read
        and you can get on with running your business.
      </p>

      <div class="hero-calm-actions">
        <a href="#contact" class="hero-calm-button">
          Get a free site health check
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
        </a>
        <p class="hero-calm-phone">Prefer to talk? <a href="tel:+447440018091">07440 018091</a></p>
      </div>
    </div>

    <div class="hero-calm-card">
      <HeroChat />
    </div>
  </div>
</section>

<style>
  .hero-calm {
    position: relative;
    overflow: hidden;
    background: var(--midnight);
    color: var(--cream);
    /* Top clears the fixed header. The side gutter is the header's own
       formula, so everything lines up with the nav at every width. */
    padding:
      calc(var(--wpb-header-h, 78px) + 4.5rem)
      max(4rem, calc((100vw - var(--frame)) / 2))
      6.5rem;
  }

  /* One soft pool of lime behind the card, in place of the old cream panel. */
  .hero-calm-glow {
    position: absolute;
    top: 50%;
    right: -12%;
    width: min(62vw, 880px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    background: radial-gradient(
      circle,
      rgba(212, 255, 58, 0.11) 0%,
      rgba(212, 255, 58, 0.04) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .hero-calm-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }

  /* ---------- copy ---------- */

  .hero-calm-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    max-width: 36rem;
  }

  .hero-calm-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    line-height: 1;
    color: rgba(245, 241, 232, 0.78);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero-calm-rating strong {
    font-weight: 600;
    color: var(--cream);
  }

  .hero-calm-rating:hover {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-calm-stars {
    color: #e5a000;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .hero-calm-headline {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.4rem, 4.2vw, 3.9rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--cream);
    text-wrap: balance;
  }

  .hero-calm-accent {
    color: var(--accent);
    white-space: nowrap;
  }

  .hero-calm-desc {
    margin: 0;
    max-width: 44ch;
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(245, 241, 232, 0.72);
  }

  .hero-calm-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    margin-top: 0.5rem;
  }

  .hero-calm-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.75rem;
    background: var(--accent);
    color: var(--accent-text);
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-calm-button:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
    box-shadow: 0 10px 30px rgba(212, 255, 58, 0.18);
  }

  .hero-calm-button svg {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .hero-calm-button:hover svg {
    transform: translateY(3px);
  }

  .hero-calm-button:focus-visible,
  .hero-calm-phone a:focus-visible,
  .hero-calm-rating:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  .hero-calm-phone {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(245, 241, 232, 0.7);
  }

  .hero-calm-phone a {
    color: var(--cream);
    text-decoration: underline;
    text-decoration-color: rgba(245, 241, 232, 0.35);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }

  .hero-calm-phone a:hover {
    text-decoration-color: var(--cream);
  }

  /* ---------- chat card ----------
     HeroChat's own styles are scoped to it, so these overrides are written
     with enough selector weight to win without !important. */

  .hero-calm-card {
    display: flex;
    justify-content: flex-end;
  }

  .hero-calm .hero-calm-card :global(.hero-chat) {
    margin: 0;
    max-width: 30rem;
    background: var(--slate);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
  }

  .hero-calm .hero-calm-card :global(.hero-chat-bar) {
    border-bottom-color: rgba(245, 241, 232, 0.07);
  }

  /* Avatar drops the lime so Chris's replies are the card's only accent. */
  .hero-calm .hero-calm-card :global(.hero-chat-avatar) {
    background: rgba(245, 241, 232, 0.12);
    color: var(--cream);
  }

  .hero-calm .hero-calm-card :global(.hero-chat-msg--client) {
    background: rgba(245, 241, 232, 0.07);
  }

  .hero-calm .hero-calm-card :global(.hero-chat-dot.is-active::before) {
    background: var(--cream);
  }

  /* ---------- entrance ----------
     One gentle fade-up. Only declared when motion is welcome, so the content
     is simply visible otherwise. The page-wide scroll reveal skips any block
     that is already animating, which is why the hero is left alone by it. */

  @media (prefers-reduced-motion: no-preference) {
    .hero-calm-copy > *,
    .hero-calm-card {
      opacity: 0;
      animation: hero-calm-in 0.7s ease forwards;
    }

    .hero-calm-copy > :nth-child(1) { animation-delay: 0.05s; }
    .hero-calm-copy > :nth-child(2) { animation-delay: 0.15s; }
    .hero-calm-copy > :nth-child(3) { animation-delay: 0.25s; }
    .hero-calm-copy > :nth-child(4) { animation-delay: 0.35s; }
    .hero-calm-card { animation-delay: 0.3s; }
  }

  @keyframes hero-calm-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- responsive ---------- */

  /* The header drops to a 2rem gutter here, so the hero does too. */
  @media (max-width: 1260px) {
    .hero-calm {
      padding-inline: 2rem;
    }
  }

  @media (max-width: 1024px) {
    .hero-calm {
      padding-bottom: 5rem;
    }

    .hero-calm-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 3.5rem;
    }

    .hero-calm-card {
      justify-content: flex-start;
    }

    .hero-calm .hero-calm-card :global(.hero-chat) {
      max-width: 34rem;
    }

    .hero-calm-glow {
      top: auto;
      bottom: -10%;
      right: -25%;
      width: min(110vw, 760px);
      transform: none;
    }
  }

  /* Phones keep the chat card. It is the clearest thing on the page. */
  @media (max-width: 768px) {
    .hero-calm {
      padding:
        calc(var(--wpb-header-h, 66px) + 2rem)
        1.25rem
        3.5rem;
    }

    .hero-calm-inner {
      gap: 2.75rem;
    }

    .hero-calm-copy {
      gap: 1.5rem;
    }

    .hero-calm-desc {
      font-size: 1.05rem;
    }

    .hero-calm .hero-calm-card :global(.hero-chat) {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .hero-calm-actions,
    .hero-calm-button {
      width: 100%;
    }

    .hero-calm-button {
      justify-content: center;
    }

    .hero-calm-phone {
      text-align: center;
      width: 100%;
    }
  }

  @media (max-width: 380px) {
    .hero-calm-headline {
      font-size: 2rem;
    }
  }
</style>

---
// CaseSection.astro — section wrapper for case study bodies.
// Label and heading sit in a head block on the left (stacked above the body
// on narrower screens); the MDX body goes in the slot, in the right-hand
// column. Wide furniture placed inside the slot spans both columns.
//
// Usage:
//   <CaseSection label="The Challenge" heading="Hitting the Limits of Squarespace">
//     prose, lists, anything...
//   </CaseSection>

interface Props {
  label: string;
  heading: string;
}

const { label, heading } = Astro.props;
---

<div class="case-section">
  <div class="case-section-head">
    <div class="case-section-label">{label}</div>
    <h2>{heading}</h2>
  </div>
  <slot />
</div>

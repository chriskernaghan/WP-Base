<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  window.gtag = gtag;

  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'granted',
    security_storage: 'granted',
    wait_for_update: 500
  });

  (function () {
    var MAX_AGE = 1000 * 60 * 60 * 24 * 365; // re-ask after 12 months
    try {
      var raw = localStorage.getItem('wpb-consent');
      if (!raw) return;
      var saved = JSON.parse(raw);
      if (!saved || !saved.time || (Date.now() - saved.time) > MAX_AGE) {
        localStorage.removeItem('wpb-consent');
        return;
      }
      window.wpbConsentSaved = saved;
      if (saved.analytics === true) {
        gtag('consent', 'update', { analytics_storage: 'granted' });
        dataLayer.push({ event: 'wpb_consent_granted' });
      }
    } catch (e) {}
  })();
</script>

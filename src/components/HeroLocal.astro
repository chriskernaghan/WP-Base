---
// HeroLocal.astro — local variant of the homepage hero, used on /northern-ireland/.
// Mirrors Hero.astro element for element: rating pill, three-line headline,
// .hero-v2-desc paragraph, CTA row and terminal feed. Only the headline accent,
// the rating pill's trailing text and the description change for local SEO.
// If Hero.astro changes structurally, change this file to match.
---

<section class="hero-v2 hero-split">
  <div class="hero-split-left">
    <div class="hero-v2-left hero-split-content">
      <a href="https://share.google/HmqVC5OhdKakcRtS4" target="_blank" rel="noopener" class="hero-v2-rating">
        <span class="hero-v2-rating-stars" aria-hidden="true">★★★★★</span>
        <span class="hero-v2-rating-text"><strong>5.0</strong> on Google<span class="hero-v2-rating-extra"> · based in Newtownabbey</span></span>
      </a>
      <h1 class="hero-v2-headline">
        WordPress care<br />
        <span class="accent">for Northern Irish<br />businesses</span>
      </h1>
      <p class="hero-v2-desc">
        Maintenance, builds and ongoing support from a developer based in
        Newtownabbey, for a fixed monthly fee and without the agency price.
      </p>
      <div class="hero-v2-cta-row">
        <a href="#contact" class="hero-v2-cta-primary">
          Get Your Free Audit
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
        </a>
        <a href="#clients" class="hero-v2-cta-secondary">See our work</a>
      </div>
    </div>
  </div>

  <div class="hero-split-right">
    <div class="hero-terminal" aria-hidden="true">
      <div class="hero-terminal-bar">
        <div class="hero-terminal-dots">
          <span></span><span></span><span></span>
        </div>
        <div class="hero-terminal-status">
          <span class="hero-terminal-pulse"></span>
          <span class="hero-terminal-status-text">All systems operational</span>
        </div>
        <div class="hero-terminal-clock" id="hero-terminal-clock">--:--:--</div>
      </div>
      <div class="hero-terminal-feed" id="hero-terminal-feed"></div>
    </div>
  </div>
</section>

---
// HeroLocal.astro: local variant of the homepage hero, used on /northern-ireland/.
// Mirrors Hero.astro: rating pill, three-line headline, .hero-v2-desc paragraph,
// CTA row and the shared HeroChat panel. The headline gains a small location
// line inside the h1 (so the keyword stays in the heading without lengthening
// the big lines), and the description names Newtownabbey and Belfast.
// If Hero.astro changes structurally, change this file to match.
//
// Updated 26 November 2026: the eyebrow line now reads "Website maintenance in
// Belfast and Northern Ireland" rather than "WordPress care in Northern
// Ireland". Search Console shows local searchers type "website maintenance",
// not "wordpress maintenance": "website maintenance belfast" and "website
// maintenance northern ireland" pulled 226 impressions in three months against
// 29 for "wordpress maintenance belfast". The eyebrow exists to carry the
// keyword in the h1, so it should carry the one people actually search for.
//
// The rating pill now reads 4.5, which is what the Google Business Profile
// currently shows (seven 5-star reviews and one 1-star with no text). Put it
// back to 5.0 if and when Google removes that review.
import HeroChat from './HeroChat.astro';
---

<section class="hero-v2 hero-split">
  <div class="hero-split-left">
    <div class="hero-v2-left hero-split-content">
      <a href="https://share.google/HmqVC5OhdKakcRtS4" target="_blank" rel="noopener" class="hero-v2-rating">
        <span class="hero-v2-rating-stars" aria-hidden="true">★★★★★</span>
        <span class="hero-v2-rating-text"><strong>4.5</strong> on Google<span class="hero-v2-rating-extra"> · clients love working with me</span></span>
      </a>
      <h1 class="hero-v2-headline">
        <span class="hero-local-eyebrow">Website maintenance in Belfast and Northern Ireland</span>
        A WordPress site<br />
        <span class="accent">you never have<br />to worry about</span>
      </h1>
      <p class="hero-v2-desc">
        I handle the updates, backups and security for a fixed monthly fee, so
        your site stays fast and safe. I'm based in Newtownabbey, I look after
        websites for small businesses in Belfast and across Northern Ireland,
        and I pick up the phone.
      </p>
      <div class="hero-v2-cta-row">
        <a href="#contact" class="hero-v2-cta-primary">
          Get a free site health check
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
        </a>
        <a href="tel:+447440018091" class="hero-v2-cta-secondary">Prefer to talk? 07440 018091</a>
      </div>
    </div>
  </div>

  <div class="hero-split-right">
    <HeroChat />
  </div>
</section>

<style>
  .hero-local-eyebrow {
    display: block;
    margin-block-end: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
</style>

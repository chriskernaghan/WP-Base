---
// WhyLocal.astro — the "why work with someone local" block on /northern-ireland/.
// Merged from the old WhyLocal and WhyNewtownabbey components when the two
// location pages were combined. The Newtownabbey copy was the stronger of the
// two because it names real places instead of arguing about timezones, so that
// specificity is kept and widened to cover the rest of Northern Ireland.
const points = [
  {
    icon: 'pin',
    title: 'Based here, not just covering it',
    body: "I work out of Newtownabbey, with clients across Belfast, Antrim, Ballyclare, Bangor and further afield. Plenty of web companies list Northern Ireland on a page of regions they serve. If you would rather talk something through in person, that is a short drive rather than a day out.",
  },
  {
    icon: 'shop',
    title: 'Mallusk to the Abbey Centre',
    body: 'A lot of the work comes from trade and manufacturing around Mallusk and Global Point, and from retail and service businesses closer to the Abbey Centre and Belfast city centre. Different businesses, same problem: a website that has to bring in enquiries and keep working.',
  },
  {
    icon: 'person',
    title: 'You deal with me',
    body: 'No account managers, no call centre, no being handed between people. The person who audits your site is the person who fixes it and the person who answers when you ring.',
  },
];
---
<section id="why-local" class="why-local-section">
  <div class="why-local-inner">
    <span class="section-label">Actually here</span>
    <h2>A Northern Ireland developer you can actually get hold of</h2>
    <p class="why-local-lead">
      Working with small businesses across Northern Ireland from a base in
      Newtownabbey, covering Glengormley, Whiteabbey, Jordanstown, Carnmoney,
      Mallusk and Ballyclare, out to Belfast, Antrim and beyond.
    </p>
    <div class="why-local-grid">
      {points.map((point) => (
        <div class="why-local-card">
          <span class="why-local-icon" aria-hidden="true">
            {point.icon === 'pin' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
            )}
            {point.icon === 'shop' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18l-1.5-5H4.5L3 9Z" /><path d="M5 9v11h14V9" /><path d="M9 20v-6h6v6" /></svg>
            )}
            {point.icon === 'person' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
            )}
          </span>
          <h3>{point.title}</h3>
          <p>{point.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

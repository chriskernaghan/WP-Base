---
// FAQ.astro — accordion FAQ. Uses native <details> so it works without JS.
// Questions live in src/data/faqs.ts so index.astro can emit matching
// FAQPage schema from the same source.
import { faqs } from '../data/faqs';
---

<section id="faq" class="faq-section">
  <div class="faq-inner">
    <span class="section-label">Questions</span>
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item" open={faq.open}>
          <summary class="faq-question">
            <span>{faq.q}</span>
            <span class="faq-icon"></span>
          </summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

---
// Footer.astro — site-wide footer
const year = new Date().getFullYear();

const services = [
  { label: 'WordPress Maintenance', href: '/wordpress-maintenance' },
  { label: 'WordPress Hosting', href: '/hosting' },
  { label: 'Website Speed', href: '/website-speed' },
  { label: 'Care Plans & Pricing', href: '/#pricing' },
];

const areas = [
  { label: 'Northern Ireland', href: '/northern-ireland' },
  { label: 'Belfast', href: '/northern-ireland' },
  { label: 'Newtownabbey', href: '/newtownabbey' },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-logo">WP Base</span>
        <p class="footer-pitch">
          Expert WordPress maintenance for small businesses across Northern Ireland
          and the UK. One person who does the work, looking after your site so you
          don't have to think about it.
        </p>
        <a href="/#contact" class="footer-cta">
          Get Your Free Audit
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>

      <div class="footer-links" role="navigation" aria-label="Footer">
        <div class="footer-col">
          <h2 class="footer-heading">Services</h2>
          <ul>
            {services.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Areas served</h2>
          <ul>
            {areas.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Get in touch</h2>
          <ul>
            <li><a href="mailto:hello@wpbase.co.uk">hello@wpbase.co.uk</a></li>
            <li><a href="tel:+447379334695">+44 7379 334695</a></li>
            <li><span class="footer-plain">Newtownabbey, Northern Ireland</span></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">&copy; {year} WP Base. All rights reserved.</p>
      <ul class="footer-legal-links">
        <li><a href="/privacy">Privacy Policy</a></li>
        <li>
          <button type="button" class="footer-legal-btn" data-cookie-settings>
            Cookie settings
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--midnight);
    color: var(--snow);
    padding: 4rem 1.5rem 2rem;
    text-align: left;
  }
  .site-footer :where(p, ul, li, h2, a, span, div) {
    text-align: left;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }
  .footer-pitch {
    font-family: 'Epilogue', sans-serif;
    font-size: 0.98rem;
    line-height: 1.65;
    opacity: 0.72;
    margin: 0.9rem 0 1.5rem;
    max-width: 34ch;
  }
  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: var(--midnight);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .footer-cta:hover {
    transform: translateY(-2px);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .footer-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 1rem;
  }
  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links li {
    margin-bottom: 0.7rem;
  }
  .footer-links a,
  .footer-plain {
    font-family: 'Epilogue', sans-serif;
    font-size: 0.98rem;
    line-height: 1.4;
    color: var(--snow);
    text-decoration: none;
    opacity: 0.78;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .footer-links a:hover {
    opacity: 1;
    color: var(--accent);
  }
  .footer-plain {
    opacity: 0.55;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-legal,
  .footer-legal-links a,
  .footer-legal-links .footer-legal-btn {
    font-family: 'Epilogue', sans-serif;
    font-size: 0.88rem;
    opacity: 0.55;
    margin: 0;
  }
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-legal-links a,
  .footer-legal-links .footer-legal-btn {
    color: var(--snow);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .footer-legal-links a:hover,
  .footer-legal-links .footer-legal-btn:hover {
    opacity: 1;
  }
  .footer-legal-links .footer-legal-btn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    line-height: inherit;
  }
  .footer-legal-links .footer-legal-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 620px) {
    .site-footer {
      padding-top: 3rem;
    }
    .footer-links {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 1rem;
    }
    .footer-pitch {
      max-width: none;
    }
    .footer-bottom {
      justify-content: flex-start;
    }
  }
</style>

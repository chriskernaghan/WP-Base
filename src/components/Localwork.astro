---
// Localwork.astro — problem-led content block on /northern-ireland/.
// Was LocalWorkNewtownabbey before the two location pages merged.
//
// Rebuilt as numbered rows rather than a second three-card grid. Sitting
// directly beneath WhyLocal, the old version repeated the same layout, the
// same icon badge and the same cream fill twice in a row, so the middle of
// the page read as one long block of identical boxes.
//
// Rows also let each job carry a contextual link to the service page that
// answers it. Before this, nothing in the body of /northern-ireland/ linked
// to /wordpress-maintenance/, /web-design/ or /website-speed/ at all. Every
// link on the page pointed at #contact, #pricing or the blog, so the only
// route to the service pages was the nav.
const jobs = [
  {
    num: '01',
    title: 'The site nobody has touched in three years',
    body: 'The person who built it has moved on, the plugins are years out of date, and nobody is confident enough to press update. I take it over, bring it current safely, and keep it that way on a monthly plan.',
    href: '/wordpress-maintenance/',
    linkLabel: 'WordPress care plans',
  },
  {
    num: '02',
    title: 'The site that looks fine but loses enquiries',
    body: "Forms that fail without telling anyone, a phone number that isn't tappable on a mobile, a contact page that takes eight seconds to load. Small things that add up to real work lost over a year.",
    href: '/website-speed/',
    linkLabel: 'Speed and performance work',
  },
  {
    num: '03',
    title: 'The site that needs replaced properly',
    body: "Sometimes the honest answer is that patching it is throwing good money after bad. When that's the case I'll say so, build you something clean, and hand it over with everything sitting in your own accounts.",
    href: '/web-design/',
    linkLabel: 'New WordPress builds',
  },
];
---
<section id="local-work" class="local-jobs">
  <div class="local-jobs-inner">
    <span class="section-label">The work</span>
    <h2>The three jobs I get asked for most</h2>
    <p class="local-jobs-lead">
      Northern Ireland businesses rarely come looking for a rebuild. They come because
      something specific has gone wrong, or because the site has stopped
      pulling its weight.
    </p>
    <div class="local-jobs-list">
      {jobs.map((job) => (
        <a class="local-job" href={job.href}>
          <span class="local-job-num" aria-hidden="true">{job.num}</span>
          <div class="local-job-text">
            <h3>{job.title}</h3>
            <p>{job.body}</p>
            <span class="local-job-link">
              {job.linkLabel}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

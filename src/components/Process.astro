---
// Process.astro — four-step process explanation.

const steps = [
  { num: '01', title: 'Free Site Health Check', body: "I review your site for performance, security and usability problems and send you an honest written assessment, with no obligation to take it further." },
  { num: '02', title: 'A Clear Plan', body: "You get a prioritised list of what needs doing now, what can wait and what each item will cost, so there are no surprises later." },
  { num: '03', title: 'Fixes Done Properly', body: "I work directly on the site using a temporary login or delegated access, never your passwords, and you keep ownership of your hosting and accounts." },
  { num: '04', title: 'Ongoing Care', body: "A monthly plan covers updates, backups and security, with a report each month showing what I've done. If something looks wrong, message me directly." },
];
---

<section id="process" class="process">
  <div class="process-inner">
    <div class="process-header">
      <span class="section-label section-label--light">How it works</span>
      <h2>What happens when you get in touch</h2>
    </div>
    <div class="process-steps-v2">
      {steps.map((step) => (
        <div class="process-step-v2">
          <div class="step-number-v2">{step.num}</div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
    <div class="process-cta">
      <a class="process-cta-button" href="#contact">Get a free site health check</a>
    </div>
  </div>
</section>

<style>
  .process-steps-v2 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .process-step-v2 {
    padding: 2.5rem 2rem;
  }

  .process-step-v2 h3 {
    margin-block: 1.25rem 1rem;
  }

  .process-step-v2 p {
    line-height: 1.7;
  }

  .process-cta {
    margin-block: 3rem 0;
  }

  .process-cta-button {
    display: inline-block;
    padding: 1rem 1.9rem;
    background: var(--accent);
    color: var(--midnight);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: opacity 0.2s ease;
    font-family: var(--cta-font);
    font-weight: var(--cta-weight);
    font-size: var(--cta-size);
  }

  .process-cta-button:hover,
  .process-cta-button:focus-visible {
    opacity: 0.88;
  }

  @media (max-width: 1100px) {
    .process-steps-v2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* On a phone each step reads as a short row, number beside the title,
     instead of four tall boxes. */
  @media (max-width: 640px) {
    .process-steps-v2 {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .process-step-v2 {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      align-items: baseline;
      padding: 1.5rem 1.35rem;
    }

    .step-number-v2 {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
    }

    .process-step-v2 h3 {
      grid-column: 2;
      grid-row: 1;
      margin-block: 0 0.5rem;
    }

    .process-step-v2 p {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>

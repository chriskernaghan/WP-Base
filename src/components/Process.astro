---
// Process.astro — four-step process explanation.

const steps = [
  { num: '01', title: 'Free Site Health Check', body: "I review your site for performance, security and usability problems and send you an honest written assessment, with no obligation to take it any further." },
  { num: '02', title: 'A Clear Plan', body: "You get a prioritised list of what needs doing now, what can wait and what each item will cost, so there are no surprises later." },
  { num: '03', title: 'Fixes Done Properly', body: "I work directly on the site using a temporary login or delegated access rather than your passwords, and you keep ownership of your hosting and accounts throughout." },
  { num: '04', title: 'Ongoing Care', body: "A monthly plan covers updates, backups and security, and you get a report each month showing exactly what I've done. If something looks wrong in between, you can message me directly." },
];
---

<section id="process" class="process">
  <div class="process-inner">
    <div class="process-header">
      <span class="section-label section-label--light">How it works</span>
      <h2>What happens when you get in touch</h2>
    </div>
    <div class="process-steps-v2">
      {steps.map((step) => (
        <div class="process-step-v2">
          <div class="step-number-v2">{step.num}</div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
    <div class="process-cta">
      <a class="process-cta-button" href="#contact">Get a free site health check</a>
    </div>
  </div>
</section>

<style>
  .process-cta {
    margin-block: 3rem 0;
  }

  .process-cta-button {
    display: inline-block;
    padding: 1.1rem 1.75rem;
    background: var(--accent);
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .process-cta-button:hover,
  .process-cta-button:focus-visible {
    opacity: 0.88;
  }
</style>

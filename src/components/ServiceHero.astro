---
// ServiceHero.astro: the calm hero shared by the service pages.
//
// Copy is deliberately short (a headline, one line, two buttons). The right
// hand side is a photo with a few white status chips floating over it. The
// photo is optional: drop a file named after the `image` prop into
// public/images/services/ (webp, jpg, jpeg, png or avif) and it appears on the
// next build with no code change. Until then a plain dark panel stands in, so
// the page never shows a broken image.
//
//   image="maintenance"  ->  public/images/services/maintenance.jpg
//
// Chips are short, honest status lines (no invented numbers). `pos` is a, b or c.
import fs from 'node:fs';
import path from 'node:path';

interface Chip {
  label: string;
  sub?: string;
  pos: 'a' | 'b' | 'c';
}

interface Props {
  headline: string;
  accent?: string;
  lead: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  image: string;
  alt: string;
  chips?: Chip[];
}

const { headline, accent, lead, primary, secondary, image, alt, chips = [] } = Astro.props;

const exts = ['webp', 'jpg', 'jpeg', 'png', 'avif'];
const found = exts.find((ext) =>
  fs.existsSync(path.join(process.cwd(), 'public', 'images', 'services', `${image}.${ext}`))
);
const photo = found ? `/images/services/${image}.${found}` : null;
---

<section class="svc-hero hero-split" aria-labelledby="svc-hero-heading">
  <div class="svc-hero-glow" aria-hidden="true"></div>

  <div class="svc-hero-inner">
    <div class="svc-hero-copy">
      <h1 class="svc-hero-headline" id="svc-hero-heading">
        {headline}{accent && <Fragment> <span class="svc-hero-accent">{accent}</span></Fragment>}
      </h1>

      <p class="svc-hero-lead">{lead}</p>

      <div class="svc-hero-actions">
        <a href={primary.href} class="svc-hero-primary">
          {primary.label}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
        </a>
        {secondary && <a href={secondary.href} class="svc-hero-secondary">{secondary.label}</a>}
      </div>
    </div>

    <div class="svc-hero-media">
      <div class="svc-hero-frame">
        {photo ? (
          <img src={photo} alt={alt} width="1200" height="960" fetchpriority="high" decoding="async" />
        ) : (
          <div class="svc-hero-placeholder" aria-hidden="true"></div>
        )}
      </div>

      {chips.map((chip) => (
        <div class={`svc-chip svc-chip--${chip.pos}`} aria-hidden="true">
          <span class="svc-chip-tick">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
          </span>
          <span class="svc-chip-text">
            <strong>{chip.label}</strong>
            {chip.sub && <span>{chip.sub}</span>}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .svc-hero {
    position: relative;
    overflow: hidden;
    background: var(--midnight);
    color: var(--cream);
    /* Top clears the fixed header; the side gutter is the header's own formula
       so the headline lines up with the logo at every width. */
    padding:
      calc(var(--wpb-header-h, 78px) + 4rem)
      max(4rem, calc((100vw - var(--frame)) / 2))
      5.5rem;
  }

  .svc-hero-glow {
    position: absolute;
    top: 50%;
    right: -12%;
    width: min(62vw, 880px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    background: radial-gradient(
      circle,
      rgba(212, 255, 58, 0.1) 0%,
      rgba(212, 255, 58, 0.035) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .svc-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 4rem;
    align-items: center;
    max-width: var(--frame);
    margin: 0 auto;
  }

  .svc-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .svc-hero-headline {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--cream);
    text-wrap: balance;
  }

  .svc-hero-accent {
    color: var(--accent);
  }

  .svc-hero-lead {
    margin: 0;
    max-width: 30rem;
    font-size: 1.15rem;
    line-height: 1.65;
    color: rgba(245, 241, 232, 0.74);
  }

  .svc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .svc-hero-primary,
  .svc-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: var(--radius-pill);
    font-family: var(--cta-font);
    font-weight: var(--cta-weight);
    font-size: var(--cta-size);
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .svc-hero-primary {
    padding: 1rem 1.75rem;
    background: var(--accent);
    color: var(--accent-text);
  }

  .svc-hero-primary:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
    box-shadow: 0 10px 30px rgba(212, 255, 58, 0.18);
  }

  .svc-hero-secondary {
    padding: calc(1rem - 1.5px) calc(1.5rem - 1.5px);
    border: 1.5px solid rgba(245, 241, 232, 0.55);
    color: var(--cream);
  }

  .svc-hero-secondary:hover {
    border-color: var(--cream);
    background: rgba(245, 241, 232, 0.08);
  }

  .svc-hero-primary:focus-visible,
  .svc-hero-secondary:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }

  /* ---------- media ---------- */

  .svc-hero-media {
    position: relative;
    min-width: 0;
  }

  .svc-hero-frame {
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--slate);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.65);
  }

  .svc-hero-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stand-in until a photo is added: a soft dark panel with a lime wash. */
  .svc-hero-placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(ellipse at 30% 25%, rgba(212, 255, 58, 0.14), transparent 60%),
      linear-gradient(160deg, #16213a 0%, #0d1526 100%);
  }

  .svc-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.75rem;
    background: #ffffff;
    color: var(--midnight);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.55);
    white-space: nowrap;
  }

  .svc-chip--a { top: 12%; left: -6%; }
  .svc-chip--b { top: 44%; right: -5%; }
  .svc-chip--c { bottom: 9%; left: 7%; }

  .svc-chip-tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--midnight);
  }

  .svc-chip-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 1.15;
  }

  .svc-chip-text strong {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .svc-chip-text span {
    font-size: 0.75rem;
    color: rgba(8, 16, 28, 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-chip--a { animation: svc-float 6s ease-in-out infinite; }
    .svc-chip--b { animation: svc-float 7s ease-in-out 1.2s infinite; }
    .svc-chip--c { animation: svc-float 6.5s ease-in-out 0.6s infinite; }
  }

  @keyframes svc-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  /* ---------- responsive ---------- */

  @media (max-width: 1260px) {
    .svc-hero { padding-inline: 2rem; }
  }

  @media (max-width: 1000px) {
    .svc-hero { padding-inline: 1.25rem; }

    .svc-hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .svc-hero-media {
      max-width: 34rem;
      width: 100%;
    }

    .svc-hero-glow {
      top: auto;
      bottom: -10%;
      right: -25%;
      width: min(110vw, 760px);
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .svc-hero {
      padding-top: calc(var(--wpb-header-h, 66px) + 2.5rem);
      padding-bottom: 3.5rem;
    }

    .svc-chip--a { left: 0.5rem; }
    .svc-chip--b { right: 0.5rem; }
    .svc-chip--c { left: 1.25rem; }
  }

  @media (max-width: 520px) {
    .svc-hero-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .svc-hero-primary,
    .svc-hero-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>

---
// Client logo strip. Placeholder wordmarks, swap each <svg> for the real logo later.
// Styles are scoped to this component, so nothing here can clash with the global CSS.
---

<section class="client-logos" aria-label="Sites and businesses I work with">
  <div class="client-logos__inner">
    <ul class="client-logos__row">

      <!-- CATAGEN -->
      <li>
        <svg viewBox="0 0 190 32" role="img" aria-label="CATAGEN">
          <text x="32" y="23" class="t-sans" font-weight="700" font-size="21" letter-spacing="3" fill="currentColor">CATAGEN</text>
        </svg>
      </li>

      <!-- Understand GLP1 -->
      <li>
        <svg viewBox="0 0 190 32" role="img" aria-label="Understand GLP1">
          <text x="0" y="23" class="t-serif" font-size="26" fill="currentColor">understand<tspan font-style="italic" fill="currentColor" opacity=".7">GLP1</tspan></text>
        </svg>
      </li>

      <!-- ExportExplore -->
      <li>
        <svg viewBox="0 0 200 32" role="img" aria-label="ExportExplore">
          <path d="M4 22L22 6M22 6H10M22 6v12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="34" y="23" class="t-sans" font-size="20" fill="currentColor"><tspan font-weight="700">Export</tspan><tspan font-weight="300">Explore</tspan></text>
        </svg>
      </li>

      <!-- Inclusion IQ -->
      <li>
        <svg viewBox="0 0 170 32" role="img" aria-label="Inclusion IQ">
          <circle cx="14" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="2.4"/>
          <circle cx="14" cy="16" r="3.2" fill="currentColor"/>
          <text x="32" y="23" class="t-sans" font-size="21" fill="currentColor"><tspan font-weight="400">Inclusion</tspan><tspan font-weight="800" dx="4">IQ</tspan></text>
        </svg>
      </li>

    </ul>
  </div>
</section>

<style>
  .client-logos {
    display: block;
    width: 100%;
    padding: 48px 0;
  }
  .client-logos__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    box-sizing: border-box;
  }
  .client-logos__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .client-logos__row li {
    flex: 0 1 auto;
    margin: 0;
    padding: 0;
  }
  .client-logos__row svg {
    height: 30px;
    width: auto;
    display: block;
    overflow: visible;
    color: currentColor;
    opacity: .5;
    transition: opacity .2s ease;
  }
  .client-logos__row li:hover svg {
    opacity: .9;
  }
  .t-sans {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
  }
  .t-serif {
    font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif;
  }

  @media (max-width: 900px) {
    .client-logos__row {
      flex-wrap: wrap;
      justify-content: center;
      gap: 28px 44px;
    }
    .client-logos__row svg {
      height: 24px;
    }
  }
</style>

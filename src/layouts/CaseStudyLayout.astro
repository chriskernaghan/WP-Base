---
// CaseStudyLayout.astro — wraps every case study.
// Hero with meta, then MDX body, then optional testimonial, then CTA.

import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    client: string;
    industry: string;
    timeline: string;
    ongoing: string;
    intro: string;
    heroLogo?: string;
    heroLogoHtml?: string;
    featuredImage?: string;
    cta: { heading: string; body: string };
    testimonial?: { quote: string; name: string; role: string };
  };
}

const { frontmatter } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = frontmatter.featuredImage ?? '/og-image.png';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: frontmatter.title,
    description: frontmatter.intro,
    image: new URL(shareImage, Astro.site).href,
    inLanguage: 'en-GB',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    about: { '@type': 'Organization', name: frontmatter.client },
    author: { '@type': 'Person', name: 'Chris Kernaghan', url: 'https://wpbase.co.uk/' },
    publisher: {
      '@type': 'Organization',
      name: 'WP Base',
      url: 'https://wpbase.co.uk/',
      logo: { '@type': 'ImageObject', url: new URL('/og-image.png', Astro.site).href },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wpbase.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: 'https://wpbase.co.uk/#clients' },
      { '@type': 'ListItem', position: 3, name: frontmatter.client, item: canonical },
    ],
  },
];

const meta = [
  { label: 'Client', value: frontmatter.client },
  { label: 'Industry', value: frontmatter.industry },
  { label: 'Timeline', value: frontmatter.timeline },
  { label: 'Ongoing', value: frontmatter.ongoing },
];
---

<BaseLayout
  title={`${frontmatter.title} — WP Base`}
  description={frontmatter.intro}
  ogImage={shareImage}
  schema={schema}
>
  <div class="case-hero">
    <div class="case-hero-content">
      {frontmatter.heroLogo && (
        <img src={frontmatter.heroLogo} alt={frontmatter.client} class="case-logo" />
      )}
      {frontmatter.heroLogoHtml && (
        <div set:html={frontmatter.heroLogoHtml}></div>
      )}
      <span class="case-label">Case Study</span>
      <h1>{frontmatter.title}</h1>
      <p class="case-hero-intro">{frontmatter.intro}</p>
      <div class="case-meta">
        {meta.map((item) => (
          <div class="case-meta-item">
            <div class="case-meta-label">{item.label}</div>
            <div class="case-meta-value">{item.value}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="case-content">
    <slot />

    {frontmatter.testimonial && (
      <div class="case-testimonial">
        <p>"{frontmatter.testimonial.quote}"</p>
        <div class="case-testimonial-attribution">
          <div class="case-testimonial-name">{frontmatter.testimonial.name}</div>
          <div class="case-testimonial-role">{frontmatter.testimonial.role}</div>
        </div>
      </div>
    )}
  </div>

  <div class="case-cta">
    <h2>{frontmatter.cta.heading}</h2>
    <p>{frontmatter.cta.body}</p>
    <a href="/#contact" class="cta-button">Get Your Free Audit</a>
  </div>
</BaseLayout>

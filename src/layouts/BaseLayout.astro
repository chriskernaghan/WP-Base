---
// BaseLayout.astro — every page wraps itself in this.
// Handles <head>, fonts, consent, gtag, nav, footer. One file to rule them all.
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import ConsentDefaults from '../components/ConsentDefaults.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

// Imported for the URL only. Vite hands back the fingerprinted path it wrote
// into dist/_astro/, which is what the preload tags below point at. The
// @font-face rules themselves live at the top of global.css.
import epilogueWoff2 from '@fontsource-variable/epilogue/files/epilogue-latin-wght-normal.woff2?url';
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  schema?: object;
  ogImage?: string;
}

const { title, description, schema, ogImage = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="WP Base" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts are self-hosted and same-origin, so there is nothing to preconnect
         to. Preloading both files means the browser starts fetching them
         alongside the stylesheet rather than waiting to discover them inside
         it, which is the difference between text painting once and text
         painting in a fallback and then reflowing. -->
    <link rel="preload" href={spaceGroteskWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={epilogueWoff2} as="font" type="font/woff2" crossorigin />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <!-- Consent defaults must run before gtag.js loads -->
    <ConsentDefaults />

    <!-- Google tag (gtag.js)
         The gtag() shim and the dataLayer come from ConsentDefaults above, so
         the two calls below run immediately and queue in order. gtag.js itself
         replays that queue when it eventually loads, which means the session
         timestamp and the config are both recorded as of page load rather than
         as of the moment the script arrives.

         The script file is deferred until the page has finished loading and the
         browser is idle, so its parse and execution cost sits outside the window
         that blocks interaction. Trade-off worth knowing: a visitor who leaves
         inside the first second or so will not be counted. -->
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-FY9Q040Q9P');

      (function () {
        var loaded = false;

        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-FY9Q040Q9P';
          s.async = true;
          document.head.appendChild(s);
        }

        function whenIdle() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGtag, { timeout: 2000 });
          } else {
            window.setTimeout(loadGtag, 500);
          }
        }

        if (document.readyState === 'complete') {
          whenIdle();
        } else {
          window.addEventListener('load', whenIdle, { once: true });
        }

        // If someone interacts before the page has settled, load it then instead
        // of waiting. Clicking a nav link is exactly the moment worth recording.
        ['pointerdown', 'keydown'].forEach(function (evt) {
          window.addEventListener(evt, loadGtag, { once: true, passive: true });
        });
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppWidget />
    <CookieBanner />

    <!-- Scroll reveal.

         Inline and at the foot of the body on purpose. It marks its targets in
         the same parse as the markup they sit in, so those blocks are hidden
         before the first paint. A bundled module script would run after the
         document had already been painted, which shows the page once and then
         hides half of it.

         Nothing is hidden until this runs. If it never runs, or the browser
         has no IntersectionObserver, or the visitor asks for reduced motion,
         every page renders as ordinary static markup.

         Targets are worked out from the markup rather than listed by class, so
         pages built later pick the effect up without anything being wired in.
         For each top-level block in <main> it takes the block's content
         children, and where one of those is a known card grid it takes the
         cards instead so they arrive one after another. Blocks that already
         run an entrance animation of their own, the homepage hero and the case
         study and blog headers among them, are left alone. -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var main = document.querySelector('main');
        if (!main) return;

        /* Grids whose children come in one after another. */
        var STAGGER = '.clients-grid-v2, .process-steps-v2, .pricing-grid, .posts-grid, .posts-list, .services-rows, .faq-list, .outcome-grid, .why-local-grid, .local-jobs-list, .timeline-items, .design-grid, .blog-featured, .case-meta';
        /* Long-form prose stays put. Paragraphs sliding around while someone
           is reading them is not the effect we are after. */
        var SKIP = '.post-body';
        var MAX_GROUP = 8;
        var MAX_CARDS = 12;
        var STEP = 60;
        /* Tags that hold no layout. The Fillout embed and the consent scripts
           sit inside content wrappers and would otherwise be counted. */
        var IGNORE = { SCRIPT: 1, STYLE: 1, TEMPLATE: 1, NOSCRIPT: 1, LINK: 1, META: 1, BR: 1 };
        var targets = [];

        function usable(el) {
          return el && el.nodeType === 1 && !IGNORE[el.tagName];
        }

        function animating(el) {
          try { return el.getAnimations({ subtree: true }).length > 0; }
          catch (e) { return false; }
        }

        function mark(el, i) {
          if (!usable(el)) return;
          el.setAttribute('data-reveal', '');
          if (i > 0) el.style.setProperty('--reveal-delay', Math.min(i, 5) * STEP + 'ms');
          targets.push(el);
        }

        function collect(block) {
          if (!usable(block) || block.matches(SKIP) || animating(block)) return;

          /* Walk past plain single-child wrappers so the stagger lands on the
             content rather than on one container holding everything. */
          var scope = block;
          var depth = 0;
          while (scope.children.length === 1 && depth < 3 && !scope.firstElementChild.matches(STAGGER)) {
            scope = scope.firstElementChild;
            depth++;
          }

          var kids = Array.prototype.slice.call(scope.children);
          if (!kids.length || kids.length > MAX_GROUP) {
            mark(block, 0);
            return;
          }

          var n = 0;
          kids.forEach(function (kid) {
            if (!usable(kid) || kid.matches(SKIP) || animating(kid)) return;
            if (kid.matches(STAGGER)) {
              var cards = Array.prototype.slice.call(kid.children);
              if (!cards.length || cards.length > MAX_CARDS) { mark(kid, n++); return; }
              cards.forEach(function (card, i) { mark(card, i); });
            } else {
              mark(kid, n++);
            }
          });
        }

        Array.prototype.forEach.call(main.children, collect);
        if (!targets.length) return;

        document.documentElement.classList.add('has-reveal');

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.setAttribute('data-reveal', 'in');
            io.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0 });

        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

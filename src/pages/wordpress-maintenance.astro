---
// wordpress-maintenance.astro — the service page for WordPress care plans.
//
// Updated 26 November 2026: this page no longer targets Northern Ireland.
// It was titled "WordPress Maintenance & Support Northern Ireland" while
// /northern-ireland/ was titled "WordPress Maintenance in Northern Ireland"
// and the homepage was titled "WordPress Maintenance for Small Businesses in
// NI". Three pages claiming the same query is why Search Console showed four
// to six pages rotating on "website maintenance belfast" with none of them
// ranking well. This page now owns the national service queries ("wordpress
// maintenance services", "wp support and maintenance", "managed wordpress
// maintenance", "wordpress maintenance uk"), which is where it was already
// picking up most of its impressions, and /northern-ireland/ owns the local
// ones. The link near the foot of the page points local visitors there, which
// also tells Google which page is the local answer.
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Marquee from '../components/Marquee.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

// The provider references the same @id the homepage declares rather than
// describing the business again. The previous version created a second,
// unlinked ProfessionalService with its own address, which is the same
// entity-splitting problem /northern-ireland/ already had fixed. It also
// carried +447379334695; the number on the Google Business Profile and
// everywhere else on the site is +447440018091, and a mismatch between the
// site and GBP works against the local signals.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'WordPress Maintenance',
  name: 'WordPress care plans',
  url: 'https://wpbase.co.uk/wordpress-maintenance/',
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  provider: {
    '@type': 'ProfessionalService',
    '@id': 'https://wpbase.co.uk/#business',
    name: 'WP Base',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447440018091',
  },
  description:
    'Ongoing WordPress maintenance for small businesses. Updates, backups, security, performance and a real person to call when something needs doing. A care plan that keeps your site working so you do not have to think about it.',
};

const included = [
  {
    title: 'Core, theme and plugin updates',
    body: 'Core, theme and plugin updates applied carefully, checked afterwards and rolled back if anything breaks.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M23 14a9 9 0 1 1-2.6-6.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M23 4v5h-5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Backups that actually work',
    body: 'Regular backups stored off your server and tested, so they restore when you need them.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><ellipse cx="14" cy="7" rx="8" ry="3.5" stroke="currentColor" stroke-width="2"/><path d="M6 7v13.5c0 1.9 3.6 3.5 8 3.5s8-1.6 8-3.5V7" stroke="currentColor" stroke-width="2"/><path d="M6 14c0 1.9 3.6 3.5 8 3.5s8-1.6 8-3.5" stroke="var(--accent)" stroke-width="2"/></svg>`,
  },
  {
    title: 'Security and uptime monitoring',
    body: 'Uptime monitoring, valid SSL and sensible login protection, so I hear about problems before your customers do.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 3.5c3.5 2 7 3 9.5 3v8c0 5.5-4 8.9-9.5 10.5C8.5 23.4 4.5 20 4.5 14.5v-8c2.5 0 6-1 9.5-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m10 14 3 3 5.5-6" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Performance kept in check',
    body: 'Load times kept honest as content and images build up, so the site stays quick for visitors.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 19a9 9 0 0 1 18 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 19l4.5-5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/><circle cx="14" cy="19" r="2" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'Small fixes and changes',
    body: 'New pages, opening hours, broken links and forms that stopped sending, all covered by your plan hours.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21.5 3.8a5.2 5.2 0 0 0-6.7 6.7L4.6 20.7a2.1 2.1 0 1 0 3 3L17.8 13.5a5.2 5.2 0 0 0 6.7-6.7l-3.3 3.3-3.3-3.3 3.6-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="6.4" cy="21.9" r="1" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'A real person to ask',
    body: 'You email me, I answer and I do the thing. No tickets and no account manager in between.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.5 5.5h17a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H13.5l-5 4.5V18.5h-3a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="10" cy="12" r="1.25" fill="var(--accent)"/><circle cx="14.5" cy="12" r="1.25" fill="var(--accent)"/><circle cx="19" cy="12" r="1.25" fill="var(--accent)"/></svg>`,
  },
];
---
<BaseLayout
  title="WordPress Maintenance & Support Plans | WP Base"
  description="Ongoing WordPress maintenance for small businesses across the UK. Updates, backups, security and a real person to call, for one fixed monthly fee."
  schema={serviceSchema}
>
  <ServiceHero
    headline="WordPress maintenance,"
    accent="handled"
    lead="Updates, backups, security and a real person to call, for one fixed monthly fee."
    primary={{ label: 'Get Your Free Audit', href: '#contact' }}
    secondary={{ label: "What's included", href: '#whats-included' }}
    image="maintenance"
    alt="A small business owner checking their website on a laptop"
    chips={[
      { label: 'Updates applied', sub: 'Core, themes and plugins', pos: 'a' },
      { label: 'Backup complete', sub: 'Stored off your server', pos: 'b' },
      { label: 'Site online', sub: 'Uptime monitored', pos: 'c' },
    ]}
  />

  <Marquee />

  <section class="maint-problem-section">
    <div class="maint-reading">
      <span class="section-label">Why it matters</span>
      <h2>A site left alone is a site slowly breaking</h2>
      <p>
        Most small business websites get built and then left alone. Updates get
        missed, forms stop sending enquiries and nobody notices until something
        gives way at the worst moment. A care plan means someone is watching, so
        you don't have to.
      </p>
    </div>
  </section>

  <section id="whats-included" class="maint-offer-section">
    <div class="maint-inner">
      <span class="section-label">What a care plan covers</span>
      <h2>Everything your site needs to keep working</h2>
      <div class="maint-grid">
        {included.map((item) => (
          <div class="maint-card">
            <div class="maint-card-icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="maint-honest-section">
    <div class="maint-reading">
      <span class="section-label">Worth saying plainly</span>
      <h2>Built for small businesses, not agencies</h2>
      <p>
        I'm one person looking after a small number of sites properly, so you deal
        with me directly and don't pay for layers of overhead. Not sure what state
        your site is in? The free audit tells you plainly what needs doing, with no
        obligation.
      </p>
      <p class="maint-related-link">
        <a href="/northern-ireland/">
          Based in Northern Ireland? Here's how I work locally →
        </a>
      </p>
      <p class="maint-related-link">
        <a href="/posts/why-wordpress-maintenance-matters/">
          Read: Why WordPress Maintenance Actually Matters →
        </a>
      </p>
      <p class="maint-related-link">
        See also <a href="/website-speed/">site speed</a> and
        <a href="/hosting/">the right hosting</a>.
      </p>
    </div>
  </section>

  <Pricing />
  <Contact />
</BaseLayout>

<style>
  .maint-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .maint-problem-section,
  .maint-honest-section {
    padding: 5rem 1.5rem;
  }
  .maint-reading {
    max-width: 800px;
    margin: 0 auto;
  }
  .maint-reading h2,
  .maint-offer-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .maint-reading p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  .maint-related-link a {
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  .maint-offer-section {
    padding: 5rem 1.5rem;
  }
  .maint-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .maint-card {
    padding: 1.75rem;
    border: 1px solid rgba(8, 16, 28, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.4);
  }
  .maint-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 16, 28, 0.12);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    color: var(--midnight);
  }
  .maint-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .maint-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }
  .maint-card p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  @media (max-width: 980px) {
    .maint-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .maint-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// Conversion page. Visitors only land here after a successful form submission,
// so a page-load conversion on this URL counts real enquiries and nothing else.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thanks, I've got your message | WP Base"
  description="Your enquiry has been sent to WP Base."
  noindex
>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { dataLayer.push(arguments); };

    try {
      if (!sessionStorage.getItem('wpbase_purchase_sent')) {
        gtag('event', 'conversion_event_purchase');
        sessionStorage.setItem('wpbase_purchase_sent', '1');
      }
    } catch (e) {}
  </script>

  <section class="thanks">
    <div class="thanks-inner">
      <h1>Thanks, I've got your message.</h1>
      <p>
        Your enquiry has landed and I'll be in touch soon. If it's urgent, you
        can reach me on WhatsApp using the button in the corner.
      </p>
      <a class="thanks-link" href="/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 6rem 1.5rem;
  }

  .thanks-inner {
    max-width: 36rem;
    text-align: center;
  }

  .thanks h1 {
    margin: 0 0 1rem;
  }

  .thanks p {
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .thanks-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .thanks-link:hover,
  .thanks-link:focus-visible {
    text-decoration: underline;
  }
</style>

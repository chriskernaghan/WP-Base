---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Marquee from '../components/Marquee.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Technical SEO',
  provider: {
    '@type': 'ProfessionalService',
    name: 'WP Base',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447440018091',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
  },
  description:
    'Technical SEO and AI search readiness for WordPress sites, included in WP Base care plans. Search Console monitoring, speed, redirects, structured data and monthly search reporting from one person in Northern Ireland.',
};

const included = [
  {
    title: 'Search Console monitoring',
    body: 'Indexing errors, crawl problems and manual actions caught early, fixed, and rechecked by Google.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="2"/><path d="m18 18 6 6" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Speed and Core Web Vitals',
    body: 'Loading speed, layout shifts and mobile responsiveness watched, with fixes for whatever drags them down.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 19a9 9 0 0 1 18 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 19l4.5-5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/><circle cx="14" cy="19" r="2" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'Broken links and redirects',
    body: 'Old addresses redirected sensibly and broken links fixed, so visitors and search engines never hit a dead end.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 16a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 12a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 13 20.7l1-1" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Titles, descriptions and structured data',
    body: 'Page titles, meta descriptions and schema kept accurate as the site changes, including your local business details.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m10 9-5 5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m18 9 5 5-5 5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'AI search readiness',
    body: 'A clearly structured site that AI crawlers can read and that says plainly who you are and where you work. It helps, but it doesn\'t guarantee a mention.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 4c.8 5.2 4.8 9.2 10 10-5.2.8-9.2 4.8-10 10-.8-5.2-4.8-9.2-10-10 5.2-.8 9.2-4.8 10-10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="22" cy="6" r="1.5" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'Monthly search reporting',
    body: 'Clicks, impressions and what I found and fixed each month, written in plain English.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 23V14M12 23V8M19 23v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 24h22" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
];
---
<BaseLayout
  title="WordPress Technical SEO Northern Ireland | WP Base"
  description="Technical SEO and AI search readiness for WordPress sites, included in WP Base care plans. Search Console monitoring, speed, structured data and monthly reporting, from one person in Northern Ireland."
  schema={serviceSchema}
>
  <ServiceHero
    headline="Technical SEO,"
    accent="without the guesswork"
    lead="Monthly monitoring, fixes and plain-English reporting, included in your care plan."
    primary={{ label: 'Get a free site health check', href: '#contact' }}
    secondary={{ label: "What's included", href: '#whats-included' }}
    image="technical-seo"
    alt="A person checking search results on their phone"
    chips={[
      { label: 'Indexing checked', sub: 'Search Console monitored', pos: 'a' },
      { label: 'Speed on track', sub: 'Core Web Vitals watched', pos: 'b' },
      { label: 'Monthly report sent', sub: 'In plain English', pos: 'c' },
    ]}
  />

  <Marquee />

  <section class="maint-problem-section">
    <div class="maint-reading">
      <span class="section-label">Why it matters</span>
      <h2>A good site that search cannot read does not get found</h2>
      <p>
        Plenty of small business sites look fine and still do badly in search, because of problems nobody can see: pages Google hasn't indexed, old addresses returning errors after a redesign, or schema that broke when a plugin updated. AI assistants lean on the same foundations, so getting them right matters more than it used to.
      </p>
    </div>
  </section>

  <section id="whats-included" class="maint-offer-section">
    <div class="maint-inner">
      <span class="section-label">What technical SEO covers</span>
      <h2>Everything that helps search engines find and understand your site</h2>
      <div class="maint-grid">
        {included.map((item) => (
          <div class="maint-card">
            <div class="maint-card-icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="maint-problem-section">
    <div class="maint-reading">
      <span class="section-label">Scope</span>
      <h2>What it covers, and what it does not</h2>
      <p>
        Technical SEO is about the health of the site itself. It doesn't include link building, content marketing or writing new pages, and I don't promise rankings, traffic or AI mentions, because none of those are in anyone's control. Content and links are separate work that I'd quote for on its own.
      </p>
      <p>
        Silver includes search stats in the monthly report, Gold adds Search Console monitoring and fixes, and Platinum adds a quarterly SEO review, all out of your plan hours.
      </p>
    </div>
  </section>

  <section class="maint-honest-section">
    <div class="maint-reading">
      <span class="section-label">Worth saying plainly</span>
      <h2>One person, looking at your site properly</h2>
      <p>
        I do this work myself for a small number of sites, so you deal with me directly, and the numbers in your report come from someone who works with Search Console and GA4 regularly.
      </p>
      <p>
        Not sure where your site stands? The free site health check tells you plainly what needs doing, with no obligation to take a plan.
      </p>
      <p class="maint-related-link">
        Technical SEO sits alongside
        <a href="/wordpress-maintenance/">WordPress maintenance</a> and
        <a href="/website-speed/">website speed</a>.
      </p>
    </div>
  </section>

  <Pricing />
  <Contact />
</BaseLayout>

<style>
    .maint-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .maint-problem-section,
  .maint-honest-section {
    padding: 5rem 1.5rem;
  }
  .maint-reading {
    max-width: 800px;
    margin: 0 auto;
  }
  .maint-reading h2,
  .maint-offer-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .maint-reading p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  .maint-related-link a {
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  .maint-offer-section {
    padding: 5rem 1.5rem;
  }
  .maint-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .maint-card {
    padding: 1.75rem;
    border: 1px solid rgba(8, 16, 28, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.4);
  }
  .maint-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 16, 28, 0.12);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    color: var(--midnight);
  }
  .maint-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .maint-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }
  .maint-card p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  @media (max-width: 980px) {
    .maint-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 720px) {
    .maint-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

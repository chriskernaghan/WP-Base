---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Technical SEO',
  provider: {
    '@type': 'ProfessionalService',
    name: 'WP Base',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447440018091',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
  },
  description:
    'Technical SEO and AI search readiness for WordPress sites, included in WP Base care plans. Search Console monitoring, speed, redirects, structured data and monthly search reporting from one person in Northern Ireland.',
};

const included = [
  {
    title: 'Search Console monitoring',
    body: "I watch Search Console for indexing errors, crawl problems and manual actions, so an email from Google does not turn into weeks of lost visibility. When something comes up, I fix it and ask Google to recheck.",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="2"/><path d="m18 18 6 6" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Speed and Core Web Vitals',
    body: 'Slow pages lose visitors and do worse in search. I keep an eye on loading speed, layout shifts and responsiveness on mobile, and fix what drags them down, so the site stays quick for the people arriving from a search.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 19a9 9 0 0 1 18 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 19l4.5-5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/><circle cx="14" cy="19" r="2" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'Broken links and redirects',
    body: 'When pages are renamed, moved or deleted, the old addresses need to point somewhere sensible. I keep redirects tidy and fix broken links, so visitors and search engines do not run into dead ends.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 16a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 12a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 13 20.7l1-1" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Titles, descriptions and structured data',
    body: "Page titles, meta descriptions and schema markup tell search engines and AI tools what each page is about. I keep them accurate and correctly formatted as the site changes, including the business details that local search relies on.",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m10 9-5 5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m18 9 5 5-5 5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'AI search readiness',
    body: "I make sure the site is clearly structured, can be read by AI crawlers and says plainly who you are, what you do and where you work. That is the technical groundwork behind GEO, and it helps, but it does not guarantee a mention.",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 4c.8 5.2 4.8 9.2 10 10-5.2.8-9.2 4.8-10 10-.8-5.2-4.8-9.2-10-10 5.2-.8 9.2-4.8 10-10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="22" cy="6" r="1.5" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'Monthly search reporting',
    body: "Each month's report covers clicks, impressions and what I found and fixed in search, written in plain English. You can see what is changing without having to learn how to read Search Console yourself.",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 23V14M12 23V8M19 23v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 24h22" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
];
---
<BaseLayout
  title="WordPress Technical SEO Northern Ireland | WP Base"
  description="Technical SEO and AI search readiness for WordPress sites, included in WP Base care plans. Search Console monitoring, speed, structured data and monthly reporting, from one person in Northern Ireland."
  schema={serviceSchema}
>
  <section class="maint-hero-section">
    <div class="maint-inner maint-hero-grid">
      <div class="maint-hero-copy">
        <span class="section-label">Technical SEO · Northern Ireland</span>
        <h1 class="maint-headline">
          Technical SEO,<br />
          <span class="accent">without the guesswork</span>
        </h1>
        <p class="maint-lead">
          Search engines and AI assistants can only recommend a site they can read,
          load and understand. Technical SEO is the work that makes sure yours can be,
          and it sits inside a WordPress care plan, so it gets done every month rather
          than once and forgotten. I monitor, fix and report, and I tell you plainly
          what the numbers show.
        </p>
        <div class="maint-cta-row">
          <a href="#contact" class="maint-cta-primary">
            Get a free site health check
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
          </a>
          <a href="#whats-included" class="maint-cta-secondary">What's included</a>
        </div>
      </div>

      <div class="maint-hero-art" aria-hidden="true">
        <svg viewBox="0 0 560 440" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <g stroke="rgba(255,255,255,0.07)" stroke-width="1">
            <line x1="60" y1="0" x2="60" y2="440"/>
            <line x1="500" y1="0" x2="500" y2="440"/>
            <line x1="0" y1="60" x2="560" y2="60"/>
            <line x1="0" y1="380" x2="560" y2="380"/>
          </g>
          <g>
            <rect x="110" y="48" width="340" height="304" rx="14" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.14)" stroke-width="1"/>
            <rect x="134" y="76" width="120" height="9" rx="4.5" fill="rgba(255,255,255,0.85)"/>
            <rect x="134" y="100" width="292" height="8" rx="4" fill="rgba(255,255,255,0.12)"/>
            <rect x="134" y="100" width="218" height="8" rx="4" fill="var(--accent)"/>
            <g>
              <rect x="134" y="132" width="292" height="44" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.12)"/>
              <circle cx="156" cy="154" r="9" fill="var(--accent)"/>
              <path d="m152 154 3 3 5.5-6" stroke="var(--midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="176" y="150" width="150" height="7" rx="3.5" fill="rgba(255,255,255,0.5)"/>
            </g>
            <g>
              <rect x="134" y="188" width="292" height="44" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.12)"/>
              <circle cx="156" cy="210" r="9" fill="var(--accent)"/>
              <path d="m152 210 3 3 5.5-6" stroke="var(--midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="176" y="206" width="118" height="7" rx="3.5" fill="rgba(255,255,255,0.5)"/>
            </g>
            <g>
              <rect x="134" y="244" width="292" height="44" rx="8" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.12)"/>
              <circle cx="156" cy="266" r="9" stroke="rgba(255,255,255,0.35)" stroke-width="2" fill="none"/>
              <rect x="176" y="262" width="136" height="7" rx="3.5" fill="rgba(255,255,255,0.3)"/>
            </g>
            <rect x="134" y="308" width="104" height="26" rx="13" fill="var(--accent)"/>
            <rect x="154" y="319" width="64" height="5" rx="2.5" fill="var(--midnight)"/>
          </g>
          <g class="hero-art-chip hero-art-chip-a">
            <rect x="404" y="112" width="132" height="56" rx="10" fill="var(--accent)"/>
            <path d="M442 128a10 10 0 1 1-8 4" stroke="var(--midnight)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            <path d="M433 126v6h6" stroke="var(--midnight)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <rect x="462" y="128" width="52" height="7" rx="3.5" fill="var(--midnight)"/>
            <rect x="462" y="142" width="36" height="7" rx="3.5" fill="var(--midnight)" opacity="0.55"/>
          </g>
          <g class="hero-art-chip hero-art-chip-b">
            <rect x="32" y="296" width="96" height="40" rx="10" fill="rgba(11,17,32,0.9)" stroke="rgba(255,255,255,0.16)"/>
            <path d="M46 316 L52 322 L64 308" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="74" y="312" width="42" height="7" rx="3.5" fill="rgba(255,255,255,0.5)"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <Marquee />

  <section class="maint-problem-section">
    <div class="maint-reading">
      <span class="section-label">Why it matters</span>
      <h2>A good site that search cannot read does not get found</h2>
      <p>
        Plenty of small business sites look fine and still do badly in search for
        reasons nobody can see. Pages that Google has not indexed, old addresses
        returning errors after a redesign, slow loading on mobile, missing or
        duplicated page titles, structured data that broke when a plugin updated. None
        of it shows when you click around the site yourself, so it can go unnoticed
        for months.
      </p>
      <p>
        Search is also changing. More people now ask an AI assistant or read an AI
        summary before they ever reach a results page, and those tools lean on the
        same foundations: a site that loads quickly, is clearly structured and says
        plainly what the business does and where. Getting those foundations right does
        not guarantee you will be mentioned, but getting them wrong makes it far less
        likely.
      </p>
    </div>
  </section>

  <section id="whats-included" class="maint-offer-section">
    <div class="maint-inner">
      <span class="section-label">What technical SEO covers</span>
      <h2>Everything that helps search engines find and understand your site</h2>
      <div class="maint-grid">
        {included.map((item) => (
          <div class="maint-card">
            <div class="maint-card-icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="maint-problem-section">
    <div class="maint-reading">
      <span class="section-label">Scope</span>
      <h2>What it covers, and what it does not</h2>
      <p>
        Technical SEO is about the health of the site itself. It does not include link
        building, outreach, content marketing or writing new pages, and I do not
        promise rankings, traffic or that an AI assistant will mention you, because
        none of those are in anyone's control. If you want help with content or links
        as well, that is separate work and I will quote for it on its own.
      </p>
      <p>
        How much you get depends on the plan. Silver includes search stats in the
        monthly report, Gold adds Search Console monitoring and fixes, and Platinum
        adds a quarterly SEO review. The work comes out of the hours included in your
        plan.
      </p>
    </div>
  </section>

  <section class="maint-honest-section">
    <div class="maint-reading">
      <span class="section-label">Worth saying plainly</span>
      <h2>One person, looking at your site properly</h2>
      <p>
        I do this work myself, for a small number of sites, so you deal with me
        directly rather than through an account manager. I also do client SEO and
        analytics work alongside maintenance, including Search Console, GA4 and
        tracking, so the numbers in your report come from someone who works with them
        regularly.
      </p>
      <p>
        Not sure where your site stands? That is what the free site health check is
        for. I take a proper look, tell you plainly what needs doing and what does
        not, and there is no obligation to take a plan afterwards.
      </p>
      <p class="maint-related-link">
        Technical SEO sits alongside
        <a href="/wordpress-maintenance/">WordPress maintenance</a> and
        <a href="/website-speed/">website speed</a>.
      </p>
    </div>
  </section>

  <Pricing />
  <Contact />
</BaseLayout>

<style>
  .maint-hero-section {
    padding: 7rem 1.5rem 4rem;
    background: var(--midnight);
    color: var(--snow);
    overflow: hidden;
  }
  .maint-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .maint-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  /* eyebrow label sits on a dark background in the hero, so lighten it */
  .maint-hero-section .section-label {
    color: var(--text-light);
  }
  .maint-headline {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    margin: 1rem 0 1.5rem;
  }
  .maint-headline .accent {
    color: var(--accent);
  }
  .maint-lead {
    font-family: 'Epilogue', sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.6;
    max-width: 640px;
    opacity: 0.9;
  }
  .maint-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  .maint-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: var(--midnight);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    padding: 0.9rem 1.5rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .maint-cta-primary:hover {
    transform: translateY(-2px);
  }
  .maint-cta-secondary {
    display: inline-flex;
    align-items: center;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    padding: 0.9rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-pill);
    text-decoration: none;
    color: var(--snow);
    transition: border-color 0.15s ease;
  }
  .maint-cta-secondary:hover {
    border-color: var(--snow);
  }

  .maint-hero-art {
    min-width: 0;
  }
  .maint-hero-art svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-art-chip-a {
    animation: heroChipFloat 6s ease-in-out infinite;
  }
  .hero-art-chip-b {
    animation: heroChipFloat 7s ease-in-out 1.2s infinite;
  }
  @keyframes heroChipFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-art-chip-a,
    .hero-art-chip-b {
      animation: none;
    }
  }

  .maint-problem-section,
  .maint-honest-section {
    padding: 4rem 1.5rem;
  }
  .maint-reading {
    max-width: 800px;
    margin: 0 auto;
  }
  .maint-reading h2,
  .maint-offer-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .maint-reading p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  .maint-related-link a {
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  .maint-offer-section {
    padding: 4rem 1.5rem;
  }
  .maint-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .maint-card {
    padding: 1.75rem;
    border: 1px solid rgba(8, 16, 28, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.4);
  }
  .maint-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 16, 28, 0.12);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    color: var(--midnight);
  }
  .maint-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .maint-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }
  .maint-card p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  @media (max-width: 980px) {
    .maint-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 960px) {
    .maint-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .maint-hero-art {
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .maint-grid {
      grid-template-columns: 1fr;
    }
    .maint-hero-section {
      padding-top: 5.5rem;
    }
  }
</style>

---
// northern-ireland.astro — the single local landing page for Northern Ireland
// and town-level search. Replaced the separate /newtownabbey/ page, which was
// close to a clone of this one and never picked up enough impressions to
// register in Search Console. Its stronger content (real place names, the
// three-jobs block, the town-level FAQ answers) was folded in here and the old
// URL 301s to this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLocal from '../components/HeroLocal.astro';
import Marquee from '../components/Marquee.astro';
import Clients from '../components/Clients.astro';
import WhyLocal from '../components/WhyLocal.astro';
import LocalWork from '../components/Localwork.astro'
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import LatestPosts from '../components/LatestPosts.astro';
import FAQLocal from '../components/FAQLocal.astro';
import Contact from '../components/Contact.astro';

// One business entity for the whole site. This references the same @id the
// homepage declares rather than inventing a second ProfessionalService, which
// is what the old #localbusiness id was doing. Three separate entities for one
// business splits the signals between them.
//
// No aggregateRating. Google's guidelines prohibit a business marking up its
// own rating about itself and it can trigger a manual action. The old version
// of this page carried 5.0 from 5 reviews. The rating still shows in search
// through the Google Business Profile, which is the legitimate route.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://wpbase.co.uk/#business',
    name: 'WP Base',
    description:
      'WordPress maintenance, web design and custom builds for small businesses across Northern Ireland.',
    url: 'https://wpbase.co.uk/northern-ireland/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447379334695',
    image: 'https://wpbase.co.uk/og-image.png',
    priceRange: '££',
    founder: { '@type': 'Person', name: 'Chris Kernaghan' },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
      { '@type': 'City', name: 'Belfast' },
      { '@type': 'City', name: 'Newtownabbey' },
      { '@type': 'City', name: 'Glengormley' },
      { '@type': 'City', name: 'Ballyclare' },
      { '@type': 'City', name: 'Antrim' },
      { '@type': 'City', name: 'Lisburn' },
    ],
    knowsAbout: ['WordPress', 'Website maintenance', 'Web design', 'WordPress migrations'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wpbase.co.uk/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Northern Ireland',
        item: 'https://wpbase.co.uk/northern-ireland/',
      },
    ],
  },
];
---
<BaseLayout
  title="WordPress Services in Northern Ireland | WP Base"
  description="WordPress care for Northern Ireland small businesses. Maintenance, custom builds, migrations and support from a developer based in Newtownabbey, covering Belfast, Glengormley, Mallusk and Ballyclare."
  schema={schema}
>
  <HeroLocal />
  <Marquee />
  <Clients />
  <WhyLocal />
  <LocalWork />
  <Process />
  <Pricing />
  <LatestPosts />
  <FAQLocal />
  <Contact />
</BaseLayout>
<script>
  import '../scripts/homepage.ts';
</script>

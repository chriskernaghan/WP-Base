// northern-ireland.astro — the single local landing page for Northern Ireland
// and town-level search. Replaced the separate /newtownabbey/ page, which was
// close to a clone of this one and never picked up enough impressions to
// register in Search Console. Its stronger content (real place names, the
// three-jobs block, the town-level FAQ answers) was folded in here and the old
// URL 301s to this page.
//
// Updated 26 November 2026: this page now owns the LOCAL maintenance queries
// and nothing else does. Search Console showed four to six pages competing for
// "website maintenance belfast" and "website maintenance northern ireland",
// with this page losing at position 48-63 while the homepage sat at 2-3 on the
// same terms. Google was already choosing this page most of the time, it just
// wasn't ranking it, so the fix is to make this page unambiguously the local
// one and stop /wordpress-maintenance/ competing for the same phrase.
//
// Note the wording: local searchers type "website maintenance", not "wordpress
// maintenance". "website maintenance belfast" and "website maintenance northern
// ireland" pulled 226 impressions in three months against 29 for "wordpress
// maintenance belfast", so the title and h1 lead with the phrase people use.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLocal from '../components/HeroLocal.astro';
import Marquee from '../components/Marquee.astro';
import Clients from '../components/Clients.astro';
import WhyLocal from '../components/WhyLocal.astro';
import LocalWork from '../components/Localwork.astro'
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import LatestPosts from '../components/LatestPosts.astro';
import FAQLocal from '../components/FAQLocal.astro';
import Contact from '../components/Contact.astro';

// One business entity for the whole site. This references the same @id the
// homepage declares rather than inventing a second ProfessionalService, which
// is what the old #localbusiness id was doing. Three separate entities for one
// business splits the signals between them.
//
// url now points at the homepage, not at this page. If this is the same entity
// as the one the homepage declares, and the matching @id says it is, then its
// canonical url has to be the same too. Pointing it here asserted two
// different homes for one business.
//
// areaServed matches the service areas set on the Google Business Profile
// (Ballymena, Antrim, Londonderry, Lisburn, Newtownabbey, Belfast), plus the
// two neighbouring towns that appear in the page copy. Same logic as the
// homepage comment about name, address and phone: if GBP and the schema
// disagree about where the business works, the signals work against each other.
//
// No aggregateRating. Google's guidelines prohibit a business marking up its
// own rating about itself and it can trigger a manual action. The old version
// of this page carried 5.0 from 5 reviews. The rating still shows in search
// through the Google Business Profile, which is the legitimate route.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://wpbase.co.uk/#business',
    name: 'WP Base',
    description:
      'Website maintenance and WordPress support for small businesses in Belfast and across Northern Ireland.',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447440018091',
    image: 'https://wpbase.co.uk/og-image.png',
    priceRange: '££',
    founder: { '@type': 'Person', name: 'Chris Kernaghan' },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
      { '@type': 'City', name: 'Belfast' },
      { '@type': 'City', name: 'Newtownabbey' },
      { '@type': 'City', name: 'Lisburn' },
      { '@type': 'City', name: 'Antrim' },
      { '@type': 'City', name: 'Ballymena' },
      { '@type': 'City', name: 'Londonderry' },
      { '@type': 'City', name: 'Glengormley' },
      { '@type': 'City', name: 'Ballyclare' },
    ],
    knowsAbout: [
      'Website maintenance',
      'WordPress maintenance',
      'WordPress support',
      'Web design',
      'WordPress migrations',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wpbase.co.uk/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Northern Ireland',
        item: 'https://wpbase.co.uk/northern-ireland/',
      },
    ],
  },
];
---
<BaseLayout
  title="Website Maintenance in Belfast & Northern Ireland | WP Base"
  description="Website maintenance and WordPress support for small businesses in Belfast and across Northern Ireland. Fixed monthly fee, based in Newtownabbey."
  schema={schema}
>
  <HeroLocal />
  <Marquee />
  <Clients />
  <WhyLocal />
  <LocalWork />
  <Process />
  <Pricing />
  <LatestPosts />
  <FAQLocal />
  <Contact />
</BaseLayout>
<script>
  import '../scripts/homepage.ts';
</script>

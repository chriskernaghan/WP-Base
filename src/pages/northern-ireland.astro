---
// northern-ireland.astro — the single local landing page for Northern Ireland
// and town-level search. Replaced the separate /newtownabbey/ page, which was
// close to a clone of this one and never picked up enough impressions to
// register in Search Console. Its stronger content (real place names, the
// three-jobs block, the town-level FAQ answers) was folded in here and the old
// URL 301s to this page.
//
// This page owns the local maintenance queries. /wordpress-maintenance/ owns
// the national ones and no longer mentions Northern Ireland in its title, so
// the two aren't competing for the same search.
//
// The hero is Hero.astro with an eyebrow, not the old HeroLocal.astro, which
// is now unused and can be deleted.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Clients from '../components/Clients.astro';
import WhyLocal from '../components/WhyLocal.astro';
import LocalWork from '../components/Localwork.astro'
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import LatestPosts from '../components/LatestPosts.astro';
import FAQLocal from '../components/FAQLocal.astro';
import Contact from '../components/Contact.astro';

// One business entity for the whole site, referencing the same @id the
// homepage declares rather than inventing a second ProfessionalService. url
// points at the homepage for the same reason.
//
// areaServed matches the service areas set on the Google Business Profile,
// plus the neighbouring towns named in the page copy.
//
// No aggregateRating. Google's guidelines prohibit a business marking up its
// own rating about itself and it can trigger a manual action. The rating shows
// in search through the Business Profile, which is the legitimate route.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://wpbase.co.uk/#business',
    name: 'WP Base',
    description:
      'Website maintenance and WordPress support for small businesses in Belfast and across Northern Ireland.',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447440018091',
    image: 'https://wpbase.co.uk/og-image.png',
    priceRange: '££',
    founder: { '@type': 'Person', name: 'Chris Kernaghan' },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
    areaServed: [
      { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
      { '@type': 'City', name: 'Belfast' },
      { '@type': 'City', name: 'Newtownabbey' },
      { '@type': 'City', name: 'Lisburn' },
      { '@type': 'City', name: 'Antrim' },
      { '@type': 'City', name: 'Ballymena' },
      { '@type': 'City', name: 'Londonderry' },
      { '@type': 'City', name: 'Glengormley' },
      { '@type': 'City', name: 'Ballyclare' },
    ],
    knowsAbout: [
      'Website maintenance',
      'WordPress maintenance',
      'WordPress support',
      'Web design',
      'WordPress migrations',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://wpbase.co.uk/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Northern Ireland',
        item: 'https://wpbase.co.uk/northern-ireland/',
      },
    ],
  },
];
---
<BaseLayout
  title="Website Maintenance in Belfast & Northern Ireland | WP Base"
  description="Website maintenance and WordPress support for small businesses in Belfast and across Northern Ireland. Fixed monthly fee, based in Newtownabbey."
  schema={schema}
>
  <Hero eyebrow="Website maintenance in Belfast and Northern Ireland" />
  <Marquee />
  <Clients />
  <WhyLocal />
  <LocalWork />
  <Process />
  <Pricing />
  <LatestPosts />
  <FAQLocal />
  <Contact />
</BaseLayout>
<script>
  import '../scripts/homepage.ts';
</script>

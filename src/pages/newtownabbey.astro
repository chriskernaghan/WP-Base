---
// newtownabbey.astro — local landing page for Newtownabbey search.
// Same template as northern-ireland.astro, with a Newtownabbey hero, a
// rewritten "why local" block, an extra block on the work local businesses
// actually ask for, and a fresh FAQ. Shared sections are reused unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroNewtownabbey from '../components/HeroNewtownabbey.astro';
import Marquee from '../components/Marquee.astro';
import Clients from '../components/Clients.astro';
import WhyNewtownabbey from '../components/WhyNewtownabbey.astro';
import LocalWorkNewtownabbey from '../components/LocalWorkNewtownabbey.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import LatestPosts from '../components/LatestPosts.astro';
import FAQNewtownabbey from '../components/FAQNewtownabbey.astro';
import Contact from '../components/Contact.astro';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://wpbase.co.uk/#localbusiness',
  name: 'WP Base',
  description:
    'WordPress maintenance, web design and custom builds for businesses in Newtownabbey and across Northern Ireland.',
  url: 'https://wpbase.co.uk/newtownabbey',
  email: 'hello@wpbase.co.uk',
  telephone: '+447379334695',
  priceRange: '££',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Newtownabbey',
    addressRegion: 'County Antrim',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'City', name: 'Newtownabbey' },
    { '@type': 'City', name: 'Glengormley' },
    { '@type': 'City', name: 'Ballyclare' },
    { '@type': 'City', name: 'Belfast' },
    { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
  ],
  knowsAbout: ['WordPress', 'Website maintenance', 'Web design', 'WordPress migrations'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '5',
  },
};
---
<BaseLayout
  title="WordPress Maintenance & Web Design in Newtownabbey — WP Base"
  description="WordPress maintenance, web design and support for Newtownabbey businesses. A local developer covering Glengormley, Mallusk, Whiteabbey and Ballyclare. Free site audit."
  schema={localBusinessSchema}
>
  <HeroNewtownabbey />
  <Marquee />
  <Clients />
  <WhyNewtownabbey />
  <LocalWorkNewtownabbey />
  <Process />
  <Pricing />
  <LatestPosts />
  <FAQNewtownabbey />
  <Contact />
</BaseLayout>

<script>
  import '../scripts/homepage.ts';
</script>

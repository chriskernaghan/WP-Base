---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Marquee from '../components/Marquee.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Web Design',
  provider: {
    '@type': 'ProfessionalService',
    name: 'WP Base',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447379334695',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
  description:
    'Web design for small businesses in Northern Ireland. Clean, fast websites built to win you enquiries, not design awards. Built properly on WordPress, easy to update, and looked after once they are live.',
};

const offer = [
  {
    title: 'Designed around what you want it to do',
    body: 'Every page earns its place by moving a visitor towards more enquiries, more bookings or a more credible look.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="2"/><circle cx="14" cy="14" r="5" stroke="currentColor" stroke-width="2"/><circle cx="14" cy="14" r="1.75" fill="var(--accent)"/></svg>`,
  },
  {
    title: 'Built properly, not bolted together',
    body: 'Clean, fast WordPress foundations that you own outright, in your own accounts, so any developer could pick it up.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 3.5 24.5 9 14 14.5 3.5 9 14 3.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3.5 14.5 14 20l10.5-5.5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3.5 19.5 14 25l10.5-5.5" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Easy for you to update',
    body: 'Opening hours and news posts are easy to change yourself, with a walkthrough when we hand over.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17.5 5.5 22.5 10.5 10 23H5v-5L17.5 5.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M15 8l5 5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Looked after once it\u2019s live',
    body: 'Most clients move onto a care plan, so the site works as well in year three as it did in week one.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 3.5c3.5 2 7 3 9.5 3v8c0 5.5-4 8.9-9.5 10.5C8.5 23.4 4.5 20 4.5 14.5v-8c2.5 0 6-1 9.5-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m10 14 3 3 5.5-6" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
];
---
<BaseLayout
  title="Web Design in Northern Ireland | WP Base"
  description="Web design for small businesses in Northern Ireland. Clean, fast websites built to win you enquiries, built properly on WordPress, and looked after once they're live."
  schema={serviceSchema}
>
  <ServiceHero
    headline="Web design that"
    accent="wins you work"
    lead="Clean, fast websites for Northern Ireland businesses, built to turn visitors into enquiries."
    primary={{ label: 'Get Your Free Audit', href: '#contact' }}
    secondary={{ label: "What you get", href: '#what-you-get' }}
    image="web-design"
    alt="A small business owner looking at their new website on a tablet"
    chips={[
      { label: 'Mobile friendly', sub: 'Looks right on any screen', pos: 'a' },
      { label: 'Contact form working', sub: 'Tested before launch', pos: 'b' },
      { label: 'Loads quickly', sub: 'Built on clean foundations', pos: 'c' },
    ]}
  />

  <Marquee />

  <section class="design-problem-section">
    <div class="design-reading">
      <span class="section-label">The uncomfortable truth</span>
      <h2>People judge your business by your website, fair or not</h2>
      <p>
        You might do brilliant work, but if someone lands on a site that looks ten years old, loads slowly or has a contact form that doesn't work, plenty will assume the business is the same. They won't tell you. They'll just click back and ring the next result on Google. A good website doesn't need to be flashy, only credible, quick on a phone and clear about how to get in touch.
      </p>
    </div>
  </section>

  <section id="what-you-get" class="design-offer-section">
    <div class="design-inner">
      <span class="section-label">What building with WP Base looks like</span>
      <h2>Designed with a purpose, built to last</h2>
      <div class="design-grid">
        {offer.map((item) => (
          <div class="design-card">
            <div class="design-card-icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="design-honest-section">
    <div class="design-reading">
      <span class="section-label">Worth saying plainly</span>
      <h2>Built to bring in enquiries, not to win design awards</h2>
      <p>
        Plenty of agencies will sell you something beautiful that takes months and leaves you dependent on them for every small change. I build sites for small businesses that need to look the part and bring in work, delivered by one person you can get on the phone.
      </p>
      <p>
        Not sure whether you need a rebuild? The free audit tells you honestly, before anyone talks about money.
      </p>
      <p class="design-related-link">
        <a href="/#clients">
          See recent work: Catagen, ExportExplore and more →
        </a>
      </p>
      <p class="design-related-link">
        A good build is only the start. See <a href="/website-speed/">website speed</a> and <a href="/wordpress-maintenance/">WordPress maintenance</a>.
      </p>
    </div>
  </section>

  <Pricing />
  <Contact />
</BaseLayout>

<style>
    .design-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .design-problem-section,
  .design-honest-section {
    padding: 5rem 1.5rem;
  }
  .design-reading {
    max-width: 800px;
    margin: 0 auto;
  }
  .design-reading h2,
  .design-offer-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .design-reading p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  .design-related-link a {
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  .design-offer-section {
    padding: 5rem 1.5rem;
  }
  .design-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .design-card {
    padding: 1.75rem;
    border: 1px solid rgba(8, 16, 28, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.4);
  }
  .design-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 16, 28, 0.12);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    color: var(--midnight);
  }
  .design-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .design-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }
  .design-card p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  @media (max-width: 720px) {
    .design-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Marquee from '../components/Marquee.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

// WP Engine partner tracking link. w_agcid is the WP Base agency ID that credits
// referrals. The _gl parameter from the portal copy was deliberately left off:
// it's Google's cross-domain linker carrying Chris's own analytics session, and
// isn't needed for attribution.
const WPE_PARTNER_URL = 'https://wpengine.com/gb/partnerspecialoffer/?w_agcid=GJO6DPZA';

const wpeIncludes = [
  'Daily and on-demand backups',
  'Free SSL and a global CDN',
  'Separate staging and live environments',
  'Threat blocking and WordPress security',
  '24/7 support from people who know WordPress',
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'WordPress hosting setup and management',
  provider: {
    '@type': 'ProfessionalService',
    name: 'WP Base',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447379334695',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
  description:
    'WordPress hosting setup and management for small businesses in Northern Ireland. The right host for your site, set up properly and looked after, in your own account. WP Base is a WP Engine agency partner.',
};

const offer = [
  {
    title: 'The right host, not the dearest one',
    body: 'Your site is matched to hosting that fits it, usually managed WordPress hosting, so you never pay for a tier you don\'t need.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4.5 7v14M23.5 7v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M8.5 14h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M11.5 11l-3 3 3 3" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16.5 11l3 3-3 3" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Set up properly from day one',
    body: 'Migration, caching, backups and SSL handled once and handled right, with no downtime for your visitors.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="4" y="4" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/><path d="m9.5 14 3 3 6-7" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'You own your account',
    body: 'Hosting is in your name with your login, so you\'re never locked in, and you can see exactly what you pay.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="9" cy="14" r="4.5" stroke="currentColor" stroke-width="2"/><path d="M13.5 14H24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M19.5 14v4M24 14v3" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Looked after, not left alone',
    body: 'Performance watched, updates applied and problems caught early. If something breaks at 9pm on a Tuesday, I deal with it.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 14s4-7.5 11-7.5S25 14 25 14s-4 7.5-11 7.5S3 14 3 14Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="14" cy="14" r="3.5" stroke="var(--accent)" stroke-width="2"/></svg>`,
  },
];
---
<BaseLayout
  title="WordPress Hosting in Northern Ireland — WP Base"
  description="WordPress hosting for Northern Ireland small businesses, chosen, set up and looked after for you, in your own account. WP Engine agency partner."
  schema={serviceSchema}
>
  <ServiceHero
    headline="Hosting sorted,"
    accent="and looked after"
    lead="The right host for your site, set up properly and managed for you, in your own account."
    primary={{ label: 'Get Your Free Audit', href: '#contact' }}
    secondary={{ label: "What you get", href: '#what-you-get' }}
    image="hosting"
    alt="A business owner confidently using their website at their desk"
    chips={[
      { label: 'Site online', sub: 'Uptime monitored', pos: 'a' },
      { label: 'Backups running', sub: 'Stored off the server', pos: 'b' },
      { label: 'SSL active', sub: 'Certificate kept valid', pos: 'c' },
    ]}
  />

  <Marquee />

  <section class="hosting-problem-section">
    <div class="hosting-reading">
      <span class="section-label">The usual story</span>
      <h2>Most businesses are on the wrong host and don't know it</h2>
      <p>
        When I audit local websites, the hosting is almost never right-sized. It's either too cheap to do its job, so the site is slow and losing you enquiries, or it's more than a small business needs, so you're overpaying. Either way nobody's watching it, because hosting gets decided once under time pressure and then forgotten.
      </p>
    </div>
  </section>

  <section id="what-you-get" class="hosting-offer-section">
    <div class="hosting-inner">
      <span class="section-label">What hosting with WP Base looks like</span>
      <h2>Right-sized, set up properly, kept running</h2>
      <div class="hosting-grid">
        {offer.map((item) => (
          <div class="hosting-card">
            <div class="hosting-card-icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="recommendation" class="hosting-wpe-section">
    <div class="hosting-inner hosting-wpe-grid">
      <div class="hosting-wpe-copy">
        <span class="section-label">Where I'd usually put you</span>
        <h2>WP Engine, for most business sites</h2>
        <p>
          I've looked after a client site on WP Engine for about four years, and the hosting has been the one part of the job I've never had to worry about. It's fast, it's built for WordPress, and their support team know what they're talking about.
        </p>
        <p>
          It's also more affordable than people expect. Their Startup plan covers a typical small business site from around £23 a month, and signing up through me gets you WP Engine's partner pricing on your first year.
        </p>
        <p>
          It isn't right for every site, and if yours would be happier somewhere simpler, I'll tell you so.
        </p>
      </div>

      <aside class="hosting-wpe-card" aria-label="WP Engine Startup plan">
        <span class="hosting-wpe-plan">WP Engine Startup</span>
        <p class="hosting-wpe-price">
          <span class="hosting-wpe-from">from around</span>
          £23<span class="hosting-wpe-per">/month</span>
        </p>
        <p class="hosting-wpe-fit">One site, up to 25,000 visits a month</p>
        <ul class="hosting-wpe-list">
          {wpeIncludes.map((item) => <li>{item}</li>)}
        </ul>
        <a href={WPE_PARTNER_URL} class="hosting-wpe-cta" target="_blank" rel="sponsored noopener">
          See the partner offer
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" /></svg>
        </a>
        <a href="#contact" class="hosting-wpe-ask">Or ask me which plan fits first</a>
        <p class="hosting-wpe-small">
          Prices are WP Engine's at the time of writing and can change. Partner pricing
          applies to new customers in their first year.
        </p>
      </aside>
    </div>
  </section>

  <section class="hosting-honest-section">
    <div class="hosting-reading">
      <span class="section-label">Worth saying plainly</span>
      <h2>I'm not a hosting company</h2>
      <p>
        I don't make my money marking up servers. I put you on the right host, in your own account, and look after it as part of looking after your website.
      </p>
      <p>
        I'm a WP Engine agency partner, so signing up through my link gets you their partner pricing, and WP Engine may pay me a referral fee. It doesn't change what I'd recommend, and you pay WP Engine directly at their price.
      </p>
      <p>
        Not sure whether your current hosting is helping or holding you back? The free audit tells you, in plain English and with no sales pitch.
      </p>
      <p class="hosting-related-link">
        <a href="/posts/wrong-hosting-northern-ireland-business/">
          Read: Why Most Northern Ireland Businesses Are Choosing the Wrong Hosting →
        </a>
      </p>
      <p class="hosting-related-link">
        Hosting feeds into <a href="/website-speed/">how fast your site loads</a> and sits alongside <a href="/wordpress-maintenance/">WordPress maintenance</a>.
      </p>
    </div>
  </section>

  <Pricing />
  <Contact />
</BaseLayout>

<style>
    .hosting-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .hosting-problem-section,
  .hosting-honest-section {
    padding: 5rem 1.5rem;
  }
  .hosting-reading {
    max-width: 800px;
    margin: 0 auto;
  }
  .hosting-reading h2,
  .hosting-offer-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .hosting-reading p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  .hosting-related-link a {
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  .hosting-offer-section {
    padding: 5rem 1.5rem;
  }
  .hosting-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .hosting-card {
    padding: 1.75rem;
    border: 1px solid rgba(8, 16, 28, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.4);
  }
  .hosting-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 16, 28, 0.12);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    color: var(--midnight);
  }
  .hosting-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .hosting-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }
  .hosting-card p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

.hosting-wpe-section {
  padding: 4rem 1.5rem;
  background: #fff;
  border-top: 1px solid rgba(8, 16, 28, 0.1);
  border-bottom: 1px solid rgba(8, 16, 28, 0.1);
}
  .hosting-wpe-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .hosting-wpe-copy h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .hosting-wpe-copy p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    color: var(--text-dark);
  }
  .hosting-wpe-card {
    background: var(--midnight);
    color: var(--snow);
    padding: 2rem;
    border-radius: var(--radius-lg);
  }
  .hosting-wpe-plan {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light);
  }
  .hosting-wpe-price {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 3rem;
    line-height: 1;
    margin: 1rem 0 0.5rem;
    color: var(--accent);
  }
  .hosting-wpe-from {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-light);
    margin-bottom: 0.35rem;
  }
  .hosting-wpe-per {
    font-size: 1rem;
    font-weight: 500;
    color: var(--snow);
    margin-left: 0.2rem;
  }
  .hosting-wpe-fit {
    font-family: 'Epilogue', sans-serif;
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
    color: var(--text-light);
  }
  .hosting-wpe-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .hosting-wpe-list li {
    font-family: 'Epilogue', sans-serif;
    font-size: 0.98rem;
    padding: 0.7rem 0 0.7rem 1.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    position: relative;
  }
  .hosting-wpe-list li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 1.05rem;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
  .hosting-wpe-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: var(--midnight);
    padding: 0.9rem 1.5rem;
    text-decoration: none;
    transition: transform 0.15s ease;
    font-family: var(--cta-font);
    font-weight: var(--cta-weight);
    font-size: var(--cta-size);
  }
  .hosting-wpe-cta:hover {
    transform: translateY(-2px);
  }
  .hosting-wpe-ask {
    display: block;
    text-align: center;
    margin-top: 1rem;
    font-family: 'Epilogue', sans-serif;
    font-size: 0.95rem;
    color: var(--snow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hosting-wpe-small {
    font-family: 'Epilogue', sans-serif;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 1.5rem 0 0;
    color: var(--text-light);
  }

  @media (max-width: 960px) {
    .hosting-wpe-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 720px) {
    .hosting-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

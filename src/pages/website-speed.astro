---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Marquee from '../components/Marquee.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Website Speed Optimisation',
  provider: {
    '@type': 'ProfessionalService',
    name: 'WP Base',
    url: 'https://wpbase.co.uk/',
    email: 'hello@wpbase.co.uk',
    telephone: '+447379334695',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newtownabbey',
      addressRegion: 'Northern Ireland',
      addressCountry: 'GB',
    },
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
  description:
    'Website speed optimisation for small businesses in Northern Ireland. A slow site loses enquiries and bookings before a visitor sees what you offer. Honest assessment, then the work to fix it.',
};

const offer = [
  {
    title: 'Find out what it actually costs you',
    body: 'I measure your site as a first-time visitor on a phone sees it, so you get plain numbers on how slow it is and where the seconds go.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="14" cy="16" r="9" stroke="currentColor" stroke-width="2"/><path d="M14 7V4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M11 3.5h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 16l4-4" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Fix the things that move the needle',
    body: 'Oversized images, bloated plugins and missing caching are predictable and usually fixable without a rebuild, so I start with the changes that matter most.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 8h18M5 14h18M5 20h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="10" cy="8" r="2.5" fill="var(--midnight)" stroke="var(--accent)" stroke-width="2"/><circle cx="18" cy="14" r="2.5" fill="var(--midnight)" stroke="var(--accent)" stroke-width="2"/><circle cx="13" cy="20" r="2.5" fill="var(--midnight)" stroke="var(--accent)" stroke-width="2"/></svg>`,
  },
  {
    title: 'Faster for the people who matter',
    body: 'The aim isn\'t a perfect score. It\'s that someone arriving from Google on their phone sees your business before they bounce.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="9" y="3" width="10" height="22" rx="2.5" stroke="currentColor" stroke-width="2"/><path d="M15.5 8.5 12 14h3.5L13 19.5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Kept fast, not just made fast',
    body: 'Sites drift slower as content and plugins pile up, so on a care plan I keep watching it.',
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M23 14a9 9 0 1 1-2.6-6.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M23 4v5h-5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
];
---
<BaseLayout
  title="Website Speed Optimisation in Northern Ireland — WP Base"
  description="Is your website slow? A slow site loses enquiries and bookings before a visitor sees what you offer. Website speed optimisation for Northern Ireland small businesses, with an honest assessment first."
  schema={serviceSchema}
>
  <ServiceHero
    headline="A slow website is"
    accent="losing you business"
    lead="Most visitors won't wait on a slow phone page. I measure how slow yours really is, then fix it."
    primary={{ label: 'Get Your Free Audit', href: '#contact' }}
    secondary={{ label: "What you get", href: '#what-you-get' }}
    image="website-speed"
    alt="A customer waiting for a website to load on their phone"
    chips={[
      { label: 'Mobile speed measured', sub: 'As a first-time visitor sees it', pos: 'a' },
      { label: 'Images optimised', sub: 'Smaller, faster pages', pos: 'b' },
      { label: 'Caching in place', sub: 'Quicker repeat visits', pos: 'c' },
    ]}
  />

  <Marquee />

  <section class="speed-problem-section">
    <div class="speed-reading">
      <span class="section-label">The usual story</span>
      <h2>It loads fine for you, and slowly for everyone else</h2>
      <p>
        You visit your own site all the time, so your browser has it saved and you're usually on good wifi, and it feels quick. A first-time visitor is often on a phone, on mobile data, landing cold from a Google search, and that's the version that counts. More than half of people abandon a site that takes longer than three seconds to load, and most of them never come back to try again.
      </p>
    </div>
  </section>

  <section id="what-you-get" class="speed-offer-section">
    <div class="speed-inner">
      <span class="section-label">What fixing it with WP Base looks like</span>
      <h2>Measured properly, fixed sensibly, kept fast</h2>
      <div class="speed-grid">
        {offer.map((item) => (
          <div class="speed-card">
            <div class="speed-card-icon" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="speed-honest-section">
    <div class="speed-reading">
      <span class="section-label">Worth saying plainly</span>
      <h2>This is about enquiries, not vanity scores</h2>
      <p>
        Speed tools give you a number out of a hundred, but I don't chase a perfect score for its own sake. A faster site keeps more of your visitors around long enough to become customers, and that's what I work towards.
      </p>
      <p>
        If you've a feeling your site is sluggish, or you've never checked, the free audit tells you where you stand, in plain English and with no sales pitch. If it's fine, I'll say so.
      </p>
      <p class="speed-related-link">
        <a href="/posts/speed-kills-slow-websites">
          Read: What a Slow Website Is Costing Your Business →
        </a>
      </p>
      <p class="speed-related-link">
        See also <a href="/hosting">hosting</a> and <a href="/wordpress-maintenance">WordPress maintenance</a>.
      </p>
    </div>
  </section>

  <Pricing />
  <Contact />
</BaseLayout>

<style>
    .speed-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .speed-problem-section,
  .speed-honest-section {
    padding: 5rem 1.5rem;
  }
  .speed-reading {
    max-width: 800px;
    margin: 0 auto;
  }
  .speed-reading h2,
  .speed-offer-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.5rem;
  }
  .speed-reading p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  .speed-related-link a {
    color: var(--midnight);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  .speed-offer-section {
    padding: 5rem 1.5rem;
  }
  .speed-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .speed-card {
    padding: 1.75rem;
    border: 1px solid rgba(8, 16, 28, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.4);
  }
  .speed-card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 16, 28, 0.12);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    color: var(--midnight);
  }
  .speed-card-icon svg {
    width: 26px;
    height: 26px;
  }
  .speed-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
  }
  .speed-card p {
    font-family: 'Epilogue', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  @media (max-width: 720px) {
    .speed-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
